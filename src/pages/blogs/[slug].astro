---
import { sanityClient } from "sanity:client";
import Layout from "../../layouts/Layout.astro";
import imageHelper, { type ImageRef } from "../../utils/imageHelper";
import { Image } from "astro:assets";
import { PortableText } from "astro-portabletext";
import BlogsAside from "../../components/BlogsAside.astro";
import { Icon } from "astro-icon/components";

type Blog = {
	title: string;
	slug: { current: string };
	categories: string[];
	author: { name: string };
	publishedAt: string;
	mainImage: ImageRef;
	verticalImage: ImageRef;
	body: any;
};

export async function getStaticPaths() {
	const blogs: Blog[] = await sanityClient.fetch(
		`*[_type == "blogs" && defined(author)] | order(publishedAt desc) {
        title,
        slug,
        "categories": categories[]->title,
        publishedAt,
        mainImage,
        verticalImage,
        body,
        "author": author->{
            name,
            image
        }
    }`,
	);
	return blogs.map((blog) => {
		return {
			params: { slug: blog.slug.current },
			props: blog,
		};
	});
}

const { slug } = Astro.params;
const { title, mainImage, categories, author, publishedAt, body } = Astro.props;
---

<Layout>
	<div
		class="relative mx-auto mb-4 flex w-full max-w-7xl flex-col gap-4 px-4 pt-32 md:mb-0 lg:flex-row xl:px-0"
	>
		<div class="lg:w-4/6">
			<nav aria-label="Breadcrumb">
				<ol class="flex items-center gap-2 py-4 text-sm font-medium text-gray-600">
					<li>
						<a href="/" class="block transition hover:text-primary">
							<span class="sr-only"> Home </span>
							<Icon name="home" />
						</a>
					</li>
					<li>
						<Icon name="chevronRight" />
					</li>
					<li>
						<a href="/resources" class="block transition hover:text-primary"> Blogs </a>
					</li>
					<li></li>
					<Icon name="chevronRight" />

					<li>
						<a href={slug} class="block transition hover:text-primary"> {title} </a>
					</li>
				</ol>
			</nav>
			<div class="my-4">
				{
					categories.map((cat) => (
						<span class="whitespace-nowrap rounded-lg bg-purple-100 px-3 py-2 text-sm font-medium text-purple-700">
							{cat}
						</span>
					))
				}
			</div>
			<h1 class="my-2 font-heading text-4xl font-semibold leading-tight text-gray-800">
				{title}
			</h1>
			<div class="my-4 flex w-full justify-between border-y border-gray-300 py-2">
				<div class="flex gap-4">
					<p class="font-medium text-gray-600">
						by <span class="text-black">{author.name}</span> in
						<span class="text-black">Tech</span>
					</p>
					<p class="font-medium text-gray-600">5 min read</p>
				</div>
				<p class="font-medium text-gray-600">
					{
						new Date(publishedAt).toLocaleDateString("en-us", {
							weekday: "long",
							year: "numeric",
							month: "long",
							day: "numeric",
						})
					}
				</p>
			</div>
			<Image
				src={imageHelper(mainImage).url()}
				class="w-full object-cover lg:rounded"
				style="height: 28em;"
				alt="Blog Image"
				inferSize={true}
			/>
			<div class="prose prose-stone my-8 max-w-none lg:prose-lg">
				<PortableText value={body} />
			</div>
		</div>
		<BlogsAside />
	</div>
</Layout>
