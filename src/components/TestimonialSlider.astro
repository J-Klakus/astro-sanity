---
import { Picture } from "astro:assets";
import { sanityClient } from "sanity:client";
import imageHelper, { type ImageRef } from "../utils/imageHelper";
import Pill from "./Pill.astro";
import { Icon } from "astro-icon/components";

interface Testimonial {
	image: ImageRef;
	testimonial: string;
	author: string;
	position: string;
}

interface Props {
	testimonials: Testimonial[];
}

const testimonials = await sanityClient.fetch(
	`*[_type == "testimonials" && defined(author)] | order(publishedAt desc)`,
);
---

<section
	class="relative bg-[url('/bg-testimonial.webp')] bg-contain bg-top bg-no-repeat md:pb-14 md:pt-32"
>
	<div class="glide-05 relative mx-auto max-w-7xl px-4">
		<Pill position="top-left" text="Testimonials" class="z-50 sm:text-xl md:-mt-20" />
		<div class="glide-05 relative w-full md:px-20">
			<!-- Slides -->
			<div class="overflow-hidden" data-glide-el="track">
				<ul
					class="whitespace-no-wrap flex-no-wrap [backface-visibility: hidden] [transform-style: preserve-3d] [touch-action: pan-Y] [will-change: transform] relative flex w-full overflow-hidden p-0"
				>
					{
						testimonials.map((testimonial: any) => (
							<li class="relative flex h-fit flex-col items-center justify-center md:h-auto md:flex-row-reverse md:gap-4 md:pb-12">
								<Picture
									fallbackFormat="jpg"
									src={imageHelper(testimonial.image).url()}
									formats={["avif", "webp"]}
									alt="A prototype of the app."
									sizes="30vw"
									widths={[400, 800, 1200, 1400]}
									class="aspect-square h-44 w-44 rounded-full object-cover"
									inferSize={true}
								/>
								<div class="static bottom-0 left-0 w-auto max-w-3xl rounded-b-xl bg-primary/60 p-4 text-white backdrop-blur-lg sm:absolute sm:p-10 md:static md:-mb-12 md:mt-auto md:w-3/5 md:rounded-xl">
									<p class="mb-6 font-heading text-base leading-normal sm:text-lg md:text-base lg:text-xl">
										“{testimonial.testimonial}"
									</p>
									<p>
										<span class="font-medium">{testimonial.author}</span> / {testimonial.position}
									</p>
								</div>
							</li>
						))
					}
				</ul>
			</div>
			<!-- Controls -->
			<div
				class="absolute left-0 top-1/3 flex h-0 w-full items-center justify-between px-4 md:top-1/2"
				data-glide-el="controls"
			>
				<button
					class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-[#beb8e4] text-primary transition duration-300 hover:border-primary focus-visible:outline-none lg:h-16 lg:w-16"
					data-glide-dir="<"
					aria-label="prev slide"
				>
					<Icon name="chevronRight" class="mr-1 rotate-180" size={72} />
				</button>
				<button
					class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-[#beb8e4] text-primary transition duration-300 hover:border-primary focus-visible:outline-none lg:h-16 lg:w-16"
					data-glide-dir=">"
					aria-label="next slide"
				>
					<Icon name="chevronRight" size={72} class="ml-1" />
				</button>
			</div>
			<!-- Indicators -->
			<div
				class="glide-bullets 3xl:pt-16 hidden w-full items-center justify-start gap-1 pt-8 md:flex"
				data-glide-el="controls[nav]"
			>
				{
					testimonials.map((_: any, index: number) => (
						<button class="group p-1" data-glide-dir={`=${index}`} aria-label="goto slide 1">
							<span class="block h-3 w-3 rounded-full bg-neutral-400/40 transition-colors duration-300 focus:outline-none" />
						</button>
					))
				}
			</div>
		</div>
	</div>
</section>
<script>
	import Glide from "@glidejs/glide";
	var glide05 = new Glide(".glide-05", {
		type: "carousel",
		focusAt: 0,
		breakpoints: {
			768: {
				perView: 1,
			},
		},
		startAt: 0,
		perView: 1,
		autoplay: false,
		animationDuration: 1000,
		gap: 2,
	});

	const slider = document.querySelector(".glide-05") as HTMLDivElement;
	if (slider) {
		const activeBullet = "glide__bullet--active";
		const bulletsContainerElement = slider.querySelector(".glide-bullets") as HTMLButtonElement;
		const changeActiveBullet = (newIndex: number, containerElement: HTMLButtonElement) => {
			console.log(newIndex, containerElement);
			const glideDir = containerElement.querySelector(`[data-glide-dir="=${newIndex}"]`);
			console.log(containerElement.querySelector(`.${activeBullet}`));
			containerElement.querySelector(`.${activeBullet}`)!.classList.remove(activeBullet);

			if (glideDir) glideDir.classList.add(activeBullet);
		};

		if (document.querySelector(".glide-05")) {
			glide05.mount();
			glide05.on("run", () => {
				requestAnimationFrame(() => changeActiveBullet(glide05.index, bulletsContainerElement));
			});
		}
	}
</script>

<style>
	.glide__bullet--active span {
		background-color: rgb(75 58 179 / 1);
	}
</style>
