---
import { Picture } from "astro:assets";
import { sanityClient } from "sanity:client";
import imageHelper from "../utils/imageHelper";

interface Testimonial {
	image: string;
	testimonial: string;
	author: string;
	position: string;
}

interface Props {
	testimonials: Testimonial[];
}

const testimonials = await sanityClient.fetch(
	`*[_type == "testimonials" && defined(author)] | order(publishedAt desc)`,
);
---

<div class="glide-05 relative mx-auto max-w-7xl px-4 sm:py-14">
	<div class="glide-05 relative w-full">
		<!-- Slides -->
		<div class="overflow-hidden" data-glide-el="track">
			<ul
				class="whitespace-no-wrap flex-no-wrap [backface-visibility: hidden] [transform-style: preserve-3d] [touch-action: pan-Y] [will-change: transform] relative flex w-full overflow-hidden p-0"
			>
				{
					testimonials.map((testimonial: any, index: number) => (
						<li class="relative">
							<Picture
								fallbackFormat="jpg"
								src={imageHelper(testimonial.image).url()}
								formats={["avif", "webp"]}
								alt="A prototype of the app."
								widths={[400, 800, 1200]}
								class="aspect-square h-full w-auto rounded-xl object-cover md:aspect-auto"
								inferSize={true}
							/>
							<div class="absolute bottom-0 left-0 p-4 text-white sm:p-10 md:w-1/2">
								<p class="mb-6 font-heading font-medium leading-normal [font-size:_clamp(0.875em,1.7vw,2.5em)]">
									“{testimonial.testimonial}"
								</p>
								<p>
									<span class="font-medium">{testimonial.author}</span> / {testimonial.position}
								</p>
							</div>
						</li>
					))
				}
			</ul>
		</div>
		<!-- Indicators -->
		<div
			class="glide-bullets 3xl:pt-16 flex w-full items-center justify-center gap-1 pt-8"
			data-glide-el="controls[nav]"
		>
			{
				testimonials.map((_: any, index: number) => (
					<button class="group p-1" data-glide-dir={`=${index}`} aria-label="goto slide 1">
						<span class="block h-3 w-3 rounded-full bg-neutral-400/40 transition-colors duration-300 focus:outline-none" />
					</button>
				))
			}
		</div>
	</div>
</div>

<script>
	import Glide from "@glidejs/glide";
	import { CustomActiveClass } from "./SliderUtils.js";
	var glide05 = new Glide(".glide-05", {
		type: "carousel",
		focusAt: 0,
		breakpoints: {
			768: {
				perView: 1,
			},
		},
		startAt: 0,
		perView: 1,
		autoplay: false,
		animationDuration: 1000,
		gap: 2,
	});

	if (document.querySelector(".glide-05")) {
		glide05.mount({ CustomActiveClass });
	}
</script>

<style>
	.is-active span {
		background-color: rgb(163 163 163 / 0.8);
	}
</style>
