---
import flexible from "../assets/flexible.webp";
import chat from "../assets/chat.webp";
import learn from "../assets/learn.webp";
import stage from "../assets/stage.webp";
import { Picture } from "astro:assets";
import Pill from "./Pill.astro";
import { Icon } from "astro-icon/components";
---

<section class="overflow-x-hidden lg:max-w-7xl mx-auto pt-8 md:pt-20">
  <div class="text-center max-w-4xl mx-auto">
    <p
      class="text-highlight bg-verylight rounded-lg w-fit px-2 py-1 uppercase font-semibold tracking-wide mb-3 mx-auto"
    >
      Features
    </p>
    <h2
      class="font-heading mt-3 text-3xl sm:text-4xl font-bold leading-10 sm:leading-[4rem] tracking-tight text-black"
    >
      Discover more tools to ease your workload
    </h2>
  </div>
  <div
    class="grid grid-cols-10 md:grid-cols-11 md:grid-rows-6 gap-4 mx-auto px-4 xl:px-0 py-8"
  >
    <div
      class="h-fit lg:h-auto col-span-10 md:col-span-7 md:row-span-2 relative group hover:cursor-pointer"
    >
      <Picture
        fallbackFormat="jpg"
        src={flexible}
        formats={["avif", "webp"]}
        alt={"infographic"}
        sizes="(max-width: 768px) 100vw, (max-width: 1298px) 60vw, 779px"
        widths={[400, 800, flexible.width]}
        class="h-auto w-full object-contain group-hover:brightness-75 transition duration-300 ease-in-out"
      />
      <div
        class="absolute inset-0 w-full h-full flex flex-col justify-between p-2 md:p-4"
      >
        <p
          class="font-heading lg:mt-3 text-lg leading-tight sm:leading-normal sm:text-3xl xl:text-4xl font-bold tracking-tight w-3/4 text-white lg:w-1/2"
        >
          Flexible & easy to the extreme
        </p>
        <p
          class="text-sm lg:text-lg leading-tight sm:leading-normal text-white lg:pb-10 w-1/2 sm:w-full lg:w-1/2"
        >
          Customize every part of the platform to fit your needs.
        </p>
      </div>
      <Pill text="Customizable" position="top-right" />
      <p
        class="hover:underline underline-offset-8 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-in-out absolute bottom-4 right-4 md:bottom-[25%] md:right-[5%] lg:bottom-11 lg:right-4 text-sm sm:text-base md:text-lg text-white"
      >
        Learn More
        <Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
      </p>
    </div>
    <div
      class="col-span-10 md:col-span-4 md:row-span-3 relative group hover:cursor-pointer"
    >
      <Picture
        fallbackFormat="jpg"
        src={learn}
        formats={["avif", "webp"]}
        alt={"infographic"}
        sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
        widths={[400, 800, learn.width]}
        class="h-auto w-full object-contain group-hover:brightness-75 transition duration-300 ease-in-out"
      />
      <Pill text="AI" position="top-left" color="purple" />
      <p
        class="hover:underline underline-offset-8 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-in-out absolute bottom-4 right-4 md:bottom-[5%] md:right-[5%] lg:bottom-6 lg:right-4 text-sm sm:text-base md:text-lg text-white"
      >
        Learn More
        <Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
      </p>
    </div>
    <div
      class="col-span-10 md:col-span-7 md:row-span-10 md:-mt-6 relative hover:cursor-pointer group"
    >
      <Picture
        fallbackFormat="jpg"
        src={chat}
        formats={["avif", "webp"]}
        alt={"infographic"}
        sizes="(max-width: 768px) 100vw, (max-width: 1298px) 60vw, 779px"
        widths={[400, 800, chat.width]}
        class="h-auto w-full object-contain group-hover:brightness-75 transition duration-300 ease-in-out"
      />
      <Pill text="Chat Navigation" position="top-left" />
      <p
        class="hover:underline underline-offset-8 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-in-out absolute bottom-4 right-4 md:bottom-[15%] md:right-[5%] lg:bottom-16 lg:right-4 text-sm sm:text-base md:text-lg text-white"
      >
        Learn More
        <Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
      </p>
    </div>
    <div
      class="col-span-10 md:col-span-4 md:row-span-6 md:-mt-0.5 relative hover:cursor-pointer group"
    >
      <Picture
        fallbackFormat="jpg"
        src={stage}
        formats={["avif", "webp"]}
        alt={"infographic"}
        sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
        widths={[400, 800, stage.width]}
        class="h-auto w-full object-contain md:-mt-1 group-hover:brightness-75 transition duration-300 ease-in-out"
      />
      <Pill text="Automation" position="top-left" />
      <p
        class="hover:underline underline-offset-8 opacity-0 group-hover:opacity-100 transition-opacity duration-200 ease-in-out absolute bottom-4 right-4 md:bottom-[5%] md:right-[5%] lg:bottom-6 lg:right-4 text-sm sm:text-base md:text-lg text-white"
      >
        Learn More
        <Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
      </p>
    </div>
  </div>
</section>
