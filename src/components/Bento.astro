---
import flexible from "../assets/flexible.webp";
import recruitment from "../assets/chat.webp";
import learn from "../assets/learn.webp";
import stage from "../assets/stage.webp";
import { Picture } from "astro:assets";
import Pill from "./Pill.astro";
import { Icon } from "astro-icon/components";
---

<section class="mx-auto overflow-x-hidden pt-8 md:pt-20 lg:max-w-7xl">
	<div class="mx-auto max-w-4xl text-center">
		<p
			class="mx-auto mb-3 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
		>
			Features
		</p>
		<h2
			class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
		>
			Discover more tools to ease your workload
		</h2>
	</div>
	<div
		class="mx-auto grid grid-cols-10 gap-4 bg-[url('/bento.webp')] bg-cover bg-no-repeat px-4 pt-8 sm:bg-[url('/bento.webp')] md:grid-cols-11 md:grid-rows-6 xl:px-0"
	>
		<div
			class="group relative col-span-10 h-fit hover:cursor-pointer md:col-span-7 md:row-span-2 lg:h-auto"
		>
			<Picture
				fallbackFormat="jpg"
				src={flexible}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 60vw, 779px"
				widths={[400, 800, flexible.width]}
				class="h-auto w-full object-contain transition duration-300 ease-in-out group-hover:brightness-75"
			/>
			<div class="absolute inset-0 flex h-full w-full flex-col justify-between p-2 md:p-4">
				<p
					class="w-3/4 font-heading text-lg font-medium leading-tight tracking-tight text-white sm:text-3xl sm:leading-normal lg:mt-3 lg:w-1/2 xl:text-4xl"
				>
					Flexible & easy to the extreme
				</p>
				<p
					class="w-1/2 text-sm leading-tight text-white sm:w-full sm:leading-normal lg:w-1/2 lg:pb-10 lg:text-lg"
				>
					Customize every part of the platform to fit your needs.
				</p>
			</div>
			<Pill text="Customizable" position="top-right" />
			<p
				class="absolute bottom-4 right-4 text-sm text-white underline-offset-8 opacity-0 transition-opacity duration-200 ease-in-out hover:underline group-hover:opacity-100 sm:text-base md:bottom-[25%] md:right-[5%] md:text-lg lg:bottom-11 lg:right-4"
			>
				Learn More
				<Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
			</p>
		</div>
		<div class="group relative col-span-10 hover:cursor-pointer md:col-span-4 md:row-span-3">
			<Picture
				fallbackFormat="jpg"
				src={learn}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
				widths={[400, 800, learn.width]}
				class="h-auto w-full object-contain transition duration-300 ease-in-out group-hover:brightness-75"
			/>
			<Pill text="Chat Navigation" position="top-left" color="purple" />
			<p
				class="absolute bottom-4 right-4 text-sm text-white underline-offset-8 opacity-0 transition-opacity duration-200 ease-in-out hover:underline group-hover:opacity-100 sm:text-base md:bottom-[5%] md:right-[5%] md:text-lg lg:bottom-6 lg:right-4"
			>
				Learn More
				<Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
			</p>
		</div>
		<div
			class="group relative col-span-10 hover:cursor-pointer md:col-span-7 md:row-span-10 md:-mt-6"
		>
			<Picture
				fallbackFormat="jpg"
				src={recruitment}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 60vw, 779px"
				widths={[400, 800, recruitment.width]}
				class="h-auto w-full rounded-xl object-contain transition duration-300 ease-in-out group-hover:brightness-75"
			/>
			<Pill text="Recruitment Suite" position="top-left" />
			<p
				class="absolute bottom-4 right-4 text-sm text-white underline-offset-8 opacity-0 transition-opacity duration-200 ease-in-out hover:underline group-hover:opacity-100 sm:text-base md:bottom-[15%] md:right-[5%] md:text-lg lg:bottom-16 lg:right-4"
			>
				Learn More
				<Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
			</p>
		</div>
		<div
			class="group relative col-span-10 hover:cursor-pointer md:col-span-4 md:row-span-6 md:-mt-0.5"
		>
			<Picture
				fallbackFormat="jpg"
				src={stage}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
				widths={[400, 800, stage.width]}
				class="h-auto w-full object-contain transition duration-300 ease-in-out group-hover:brightness-75 md:-mt-1"
			/>
			<Pill text="Automation" position="top-left" />
			<p
				class="absolute bottom-4 right-4 text-sm text-white underline-offset-8 opacity-0 transition-opacity duration-200 ease-in-out hover:underline group-hover:opacity-100 sm:text-base md:bottom-[5%] md:right-[5%] md:text-lg lg:bottom-6 lg:right-4"
			>
				Learn More
				<Icon name="arrowRight" class="ml-2 inline-block text-inherit" />
			</p>
		</div>
	</div>
</section>
