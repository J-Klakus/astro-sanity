---
import { Icon } from "astro-icon/components";
import { sanityClient } from "sanity:client";

const footer = await sanityClient.fetch(`*[_type == "footer"][0]`);
const { points, pointTitle, description, sections, socialLinks } = footer;
---

<footer class="bg-white">
	<div class="border-y-2 border-purple-100">
		<ul
			class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-y-2 px-8 py-5 text-start font-medium text-gray-700 sm:justify-evenly sm:divide-x-2 sm:px-6 sm:text-center"
		>
			<li class="hidden w-full flex-grow items-center justify-start font-medium sm:w-auto lg:flex">
				<Icon name="logoNoText" class="mr-2 h-auto w-6" />
				{pointTitle}
			</li>
			{
				points
					.slice(0, 4)
					.map((point: any) => <li class="w-1/2 sm:w-auto sm:flex-grow">{point}</li>)
			}
		</ul>
	</div>
	<div class="mx-auto max-w-screen-xl space-y-8 px-8 py-4 sm:px-6 sm:py-16 lg:space-y-16 lg:px-8">
		<div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
			<div>
				<div>
					<a href="/" aria-label="Home Page">
						<Icon name="logo" class="h-auto w-28" />
					</a>
				</div>

				<p class="mt-4 max-w-xs text-gray-500">
					{description}
				</p>

				<ul class="mt-8 flex gap-6">
					{
						socialLinks.map((link: { link: string; platform: string; icon: string }) => (
							<li>
								<a
									href={link.link}
									rel="noreferrer"
									target="_blank"
									class="text-gray-700 transition duration-300 hover:text-primary"
								>
									<span class="sr-only">{link.platform}</span>

									<Icon name={link.icon} size={28} />
								</a>
							</li>
						))
					}
				</ul>
			</div>

			<div class="grid grid-cols-1 gap-8 sm:grid-cols-2 lg:col-span-2 lg:grid-cols-3">
				{
					sections.map((section: any, index: number) => (
						<div>
							<p class="font-medium uppercase text-gray-900">{section.section}</p>

							<ul class="mt-6 space-y-4 text-sm">
								{section.items.map((item: any) => (
									<li>
										<a href={item.link} class="text-gray-700 transition hover:opacity-75">
											{item.name}
										</a>
									</li>
								))}
								{index === sections.length - 1 && (
									<li>
										<button
											class="text-gray-700 transition duration-300 hover:text-primary"
											type="button"
											data-cc="show-preferencesModal"
										>
											Cookies
										</button>
									</li>
								)}
							</ul>
						</div>
					))
				}
			</div>
		</div>

		<p class="text-center text-sm text-gray-500">&copy; Airhire All rights reserved.</p>
	</div>
</footer>
