---
import { Icon } from "astro-icon/components";
import Button from "./reusable/Button.astro";
import logo from "../icons/iconGradient.svg";
import { Image } from "astro:assets";
---

<section class="bg-[url('/bg-mobile.webp')] bg-cover bg-no-repeat sm:bg-[url('/spots-tl.webp')]">
	<div class="mx-auto max-w-7xl">
		<div
			class="mx-auto flex flex-col-reverse items-center justify-center gap-8 px-4 lg:flex-row-reverse lg:gap-16"
		>
			<div class="bg-white p-2 md:px-12 md:py-52 lg:w-1/2">
				<form>
					<p class="mb-6 font-heading text-lg font-medium text-primary sm:text-2xl">Lets Talk!</p>
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0">
						<!-- Left Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="full-name"
									>Name</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="full-name"
									type="text"
									placeholder="Full Name"
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="phone">Phone</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="phone"
									type="text"
									placeholder="(000) 000 000 000"
								/>
							</div>
						</div>
						<!-- Right Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="email">Email</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="email"
									type="email"
									placeholder="Email address"
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="company"
									>Company</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="company"
									type="text"
									placeholder="Company name"
								/>
							</div>
						</div>
						<div class="col-span-2 mb-4">
							<label class="mb-2 block text-sm font-medium text-primary" for="message"
								>Message</label
							>
							<textarea
								rows={6}
								class="focus:shadow-outline w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
								id="website"></textarea>
						</div>
					</div>
					<div class="mt-6 flex justify-end">
						<Button buttonText="Submit" link="/" type="filled" />
					</div>
				</form>
			</div>
			<div class="lg:w-1/2">
				<Image src={logo} class="mb-8 h-12 w-auto" alt="logo" />
				<h2
					class="mb-6 bg-[linear-gradient(112deg,#4B3AB3_40%,#9FFFF3_100%)] bg-clip-text font-heading text-lg font-medium text-transparent sm:text-3xl"
				>
					Revolutionize your recruitment and achieve unmatched results.
				</h2>
				<ul class="space-y-4 font-heading text-xl font-medium text-black">
					<li>
						<Icon name="tick" class="mb-0.5 mr-2 inline" size={20} /> Tap into expertise <p
							class="mb-6 ml-8 font-heading text-base font-normal text-gray-900"
						>
							Connect with a product consultant to learn how Airhire can transform your recruitment
							strategy globally.
						</p>
					</li>
					<li>
						<Icon name="tick" class="mb-0.5 mr-2 inline" size={20} /> Proven Success <p
							class="mb-6 ml-8 font-heading text-base font-normal text-gray-900"
						>
							Join our growing community of satisfied clients and find a pricing plan that matches
							your business objectives.
						</p>
					</li>
					<li>
						<Icon name="tick" class="mb-0.5 mr-2 inline" size={20} /> Flexibility <p
							class="mb-6 ml-8 font-heading text-base font-normal text-gray-900"
						>
							Boost productivity from day one by customizing workflows that fit your team’s unique
							recruitment processes.
						</p>
					</li>
				</ul>
			</div>
		</div>
	</div>
</section>
