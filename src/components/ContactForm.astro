---
import { Icon } from "astro-icon/components";
import FormButton from "./reusable/FormButton.astro";
import logo from "../icons/logo.svg";
import { Image } from "astro:assets";

const { title, text, text2, formTitle, list } = Astro.props;
---

<section
	class="bg-[url('/spots-tl-mobile.webp')] bg-contain bg-no-repeat sm:bg-cover lg:bg-[url('/spots-tl.webp')]"
>
	<div class="mx-auto max-w-7xl py-32 md:py-0">
		<div
			class="mx-auto flex flex-col-reverse items-center justify-center gap-8 px-4 lg:flex-row-reverse"
		>
			<div class="w-full max-w-sm bg-white p-2 lg:w-1/2 lg:max-w-none lg:px-12 lg:py-52">
				<form action="https://submit-form.com/MTMFENfyt">
					<input type="hidden" name="form-type" value="contact form" />
					{
						formTitle && (
							<p class="font-heading text-primary mb-6 font-medium sm:text-2xl">{formTitle}</p>
						)
					}
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0">
						<div class="col-span-1">
							<div class="mb-4">
								<input type="hidden" name="_redirect" value={Astro.site + "success"} />
								<input type="hidden" name="_error" value={Astro.site + "error"} />
								<input type="hidden" name="_append" value="false" />
								<label class="text-primary mb-2 block text-sm font-medium" for="full-name"
									>Name</label
								>
								<input
									class="focus:shadow-outline text-primary h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight focus:outline-none"
									id="full-name"
									type="text"
									name="full-name"
									placeholder="Full Name"
									required
								/>
							</div>
							<div class="mb-4">
								<label class="text-primary mb-2 block text-sm font-medium" for="phone">Phone</label>
								<input
									class="focus:shadow-outline text-primary h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight focus:outline-none"
									id="phone"
									type="text"
									placeholder="(000) 000 000 000"
								/>
							</div>
						</div>
						<div>
							<div class="mb-4">
								<label class="text-primary mb-2 block text-sm font-medium" for="email">Email</label>
								<input
									class="focus:shadow-outline text-primary h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight focus:outline-none"
									id="email"
									type="email"
									name="email"
									placeholder="Email address"
									required
								/>
							</div>
							<div class="mb-4">
								<label class="text-primary mb-2 block text-sm font-medium" for="company"
									>Company</label
								>
								<input
									class="focus:shadow-outline text-primary h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight focus:outline-none"
									id="company"
									name="company"
									type="text"
									placeholder="Company name"
								/>
							</div>
						</div>
						<div class="col-span-1 mb-4 md:col-span-2">
							<label class="text-primary mb-2 block text-sm font-medium" for="message"
								>Message</label
							>
							<textarea
								rows={6}
								name="message"
								class="focus:shadow-outline text-primary w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight focus:outline-none"
								id="message"
								required></textarea>
						</div>
					</div>
					<div class="mt-6 flex justify-start md:justify-end">
						<FormButton buttonText="Submit" link="/" type="filled" />
					</div>
				</form>
			</div>
			<div class="max-w-xl px-4 lg:w-1/2">
				<Image src={logo} class="mb-8 h-12 w-auto" alt="logo" />
				<h2
					class="font-heading mb-6 bg-[linear-gradient(112deg,#4B3AB3_40%,#9FFFF3_100%)] bg-clip-text text-xl font-medium text-transparent sm:text-3xl"
				>
					{title}
				</h2>
				{text && <p class="font-heading mb-6 font-normal text-gray-500">{text}</p>}
				{text2 && <p class="font-heading mb-6 font-normal text-gray-500">{text2}</p>}
				{
					list && (
						<ul class="font-heading space-y-4 font-medium text-black sm:text-xl">
							{list.map((item: { title: string; text: string }) => (
								<li>
									<Icon name="tick" class="mr-2 mb-0.5 inline" size={20} /> {item.title}{" "}
									{item.text && (
										<p class="font-heading mb-6 ml-8 text-base font-normal text-gray-900">
											{item.text}
										</p>
									)}
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</div>
</section>
