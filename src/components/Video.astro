---
const { video, text } = Astro.props;
import { YouTube } from "@astro-community/astro-embed-youtube";
---

<div
	class="video aspect-video w-full px-4 shadow-[0px_20px_50px_10px_rgba(209,249,244,1)] sm:px-0 md:min-h-[500px]"
>
	<div class="mx-auto max-w-7xl">
		<div class="w-full overflow-hidden rounded-lg">
			{
				video.includes("youtu.be") ? (
					<>
						<YouTube id={video} />
						<p class="mt-2 text-center sm:text-lg">{text}</p>
					</>
				) : (
					<video autoplay={true} loop={true} muted={true}>
						<source src={video} />
					</video>
				)
			}
		</div>
	</div>
</div>
