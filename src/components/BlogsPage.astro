---
import { Icon } from "astro-icon/components";
import { Picture, getImage } from "astro:assets";
import { sanityClient } from "sanity:client";
import BlogCard from "./reusable/BlogCard.astro";

const blogs = await sanityClient.fetch(
	`*[_type == "blogs" && defined(author)] | order(publishedAt desc) {
        title,
        slug,
        "categories": categories[]->title,
        publishedAt,
        mainImage,
        verticalImage,
        "author": author->{
            name,
            image
        }
    }`,
);
---

<section
	class="flex flex-col items-center justify-center gap-8 bg-[url('/bg-slider-mobile.webp')] bg-cover bg-top bg-no-repeat px-6 pb-8 pt-32 sm:bg-[url('/mesh-big.webp')] md:pb-52 lg:pb-20 lg:pt-44"
>
	<div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-8 px-4 lg:flex-row">
		<div class="max-w-xl">
			<div class="text-center lg:text-start">
				<h1
					class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-6xl sm:!leading-[4.75rem]"
				>
					Your Knowledge Hub: Dive into Inspiration!
				</h1>
				<p class="mt-6 leading-relaxed text-slate-500 sm:text-lg">
					Explore insights, articles, tutorials & more to supercharge your recruitment productivity.
				</p>
			</div>
		</div>
		<BlogCard blog={blogs[0]} />
	</div>
	<div class="mx-auto flex w-full max-w-7xl justify-between pt-20">
		<h2 class="mb-6 font-heading font-medium text-gray-900 sm:text-3xl">Blogs & Resources</h2>
		<div class="h-fit divide-x rounded-lg border border-[#E3E0F3] font-medium">
			<button class="px-4 py-3">Recent</button>
			<button class="bg-[#E3E0F3] px-2 py-3 text-primary">Popular</button>
		</div>
	</div>
</section>
<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 pb-20 md:grid-cols-3">
	{[1, 2, 3, 4, 5, 6, 7].map((blog, index) => <BlogCard index={index} blog={blogs[0]} />)}
</div>
