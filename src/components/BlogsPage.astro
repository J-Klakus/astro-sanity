---
import { sanityClient } from "sanity:client";
import BlogCard from "./reusable/BlogCard.astro";
import { type ImageRef } from "../utils/imageHelper";

type Blog = {
	title: string;
	slug: { current: string };
	categories: string[];
	publishedAt: string;
	mainImage: ImageRef;
	verticalImage: ImageRef;
};

const blogs = await sanityClient.fetch(
	`*[_type == "blogs" && defined(author)] | order(publishedAt desc) {
        title,
        slug,
        "categories": categories[]->title,
        publishedAt,
        mainImage,
		"estimatedReadingTime": round(length(pt::text(body)) / 5 / 180 ),
        verticalImage,
		isPopular,
        "author": author->{
            name,
            image
        }
    }`,
);
---

<section
	class="flex flex-col items-center justify-center gap-8 bg-[url('/bg-slider-mobile.webp')] bg-cover bg-top bg-no-repeat px-4 pb-8 pt-32 sm:bg-[url('/mesh-big.webp')] md:pb-52 lg:pb-20 lg:pt-44 xl:px-0"
>
	<div class="mx-auto flex max-w-7xl flex-col items-center justify-center gap-8 lg:flex-row">
		<div class="max-w-xl">
			<div class="text-center lg:text-start">
				<h1
					class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-6xl sm:!leading-[4.75rem]"
				>
					Your Knowledge Hub: Dive into Inspiration!
				</h1>
				<p class="mt-6 leading-relaxed text-slate-500 sm:text-lg">
					Explore insights, articles, tutorials & more to supercharge your recruitment productivity.
				</p>
			</div>
		</div>
		<BlogCard blog={blogs[0]} />
	</div>
	<div class="mx-auto flex w-full max-w-7xl items-center justify-between pt-8 lg:pt-20">
		<h2 class="font-heading font-medium text-gray-900 sm:text-3xl lg:mb-6">Blogs & Resources</h2>
		<div class="inline-flex rounded-lg border border-[#E3E0F3] bg-gray-100 p-1 font-medium">
			<button
				aria-pressed="true"
				class="inline-block rounded-md px-4 py-2 text-sm text-gray-700 hover:text-primary focus:relative aria-pressed:bg-white"
			>
				Recent
			</button>

			<button
				class="inline-block rounded-md px-4 py-2 text-sm text-gray-700 hover:text-primary focus:relative aria-pressed:bg-white"
			>
				Popular
			</button>
		</div>
	</div>
</section>
<div class="mx-auto grid max-w-7xl grid-cols-1 gap-8 px-4 pb-20 md:grid-cols-3 xl:px-0">
	{blogs.slice(1).map((blog: Blog, index: number) => <BlogCard index={index} blog={blog} />)}
</div>

<script>
	const blogs = document.querySelectorAll(".blog-card");

	const buttons = document.querySelectorAll("button");
	buttons.forEach((button) => {
		button.addEventListener("click", () => {
			// Remove "active" class and set aria-pressed="false" from all buttons
			buttons.forEach((btn) => {
				btn.classList.remove("active");
				btn.setAttribute("aria-pressed", "false");
			});

			const sortType = button.innerText.toLowerCase();
			const popularBlogs = Array.from(blogs).filter(
				(blog) => blog.getAttribute("data-popular") !== null,
			);

			blogs.forEach((blog, index) => {
				// Remove all classes starting with "order-"
				blog.classList.forEach((className) => {
					if (className.startsWith("order-")) {
						blog.classList.remove(className);
					}
				});

				if (sortType === "recent") {
					// Handle recent sorting logic if needed
				} else if (sortType === "popular" && popularBlogs.includes(blog)) {
					// Assign new order class here for popular blogs
					blog.classList.add(`order-first`);
				}
			});

			// Add "active" class and set aria-pressed="true" to the clicked button
			button.classList.add("active");
			button.setAttribute("aria-pressed", "true");
		});
	});
</script>
