											/>
											<div
												class={`${generateClassBasedOnIndex(i)} flex w-full flex-col justify-start rounded-b-xl p-4 sm:p-6`}
											>
												<div class="flex w-full justify-between">
													<p class="mb-3 text-sm font-medium sm:text-base">{post.category}</p>
													<p class="mb-3 text-sm font-medium sm:text-base">{post.date}</p>
												</div>
												<p class="font-medium leading-tight tracking-wide [font-size:_clamp(1em,1.2vw,2.5em)] md:leading-normal">
													{post.title}
												</p>
											</div>
											<Icon
												name="diagonalArrow"
												class="absolute right-1 top-2 h-auto w-12 sm:right-3 sm:top-3"
											/>
										</figure>
									</a>
								</li>
							))
						}
					</ul>
