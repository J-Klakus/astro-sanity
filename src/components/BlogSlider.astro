---
import { Image } from "astro:assets";
import Button from "./reusable/Button.astro";
import { Icon } from "astro-icon/components";
import { sanityClient } from "sanity:client";
import imageHelper, { type ImageRef } from "../utils/imageHelper";

const { title, header, text } = Astro.props;

type Blog = {
	title: string;
	slug: { current: string };
	categories: string[];
	publishedAt: string;
	mainImage: ImageRef;
	verticalImage: ImageRef;
};

const blogs = await sanityClient.fetch(
	`*[_type == "blogs" && defined(author)] | order(publishedAt desc) {
        title,
        slug,
        "categories": categories[]->title,
        publishedAt,
        mainImage,
        verticalImage,
        "author": author->{
            name,
            image
        }
    }`,
);

const generateClassBasedOnIndex = (index: number) => {
	if (index % 2 != 0) {
		return "absolute left-0 bottom-0 backdrop-blur-lg bg-gradient-to-r from-[#8b54ff99]/60 to-[#9ffff3]/60 bg-opacity-70 text-white";
	} else {
		return "bg-white text-black";
	}
};
---

<section
	class="bg-[url('/mesh-center-mobile.webp')] bg-cover bg-[100%_-50%] bg-no-repeat sm:bg-[url('/mesh-center.webp')]"
>
	<div class="mx-auto max-w-7xl pb-10">
		<div class="flex items-center justify-between px-4 py-2"></div>
		<div class="glide-06 relative">
			<div class="mb-6 flex items-center justify-between gap-4 px-4 md:mb-10 lg:mb-20">
				<div class="mx-auto max-w-2xl px-4 text-center">
					<p
						class="mx-auto mb-3 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-primary"
					>
						{header}
					</p>
					<h2
						class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
					>
						{title}
					</h2>
					<p class="my-3 leading-relaxed text-slate-500 sm:text-lg">
						{text}
					</p>
					<Button link="/resources" buttonText="Show More" type="filled" class="w-fit" />
				</div>
			</div>
			<div class="glide-06 relative w-full">
				<!-- Slides -->
				<div class="overflow-hidden" data-glide-el="track">
					<ul
						class="whitespace-no-wrap flex-no-wrap [backface-visibility: hidden] [transform-style: preserve-3d] [touch-action: pan-Y] [will-change: transform] relative flex w-full gap-6 overflow-hidden p-0"
					>
						{
							blogs.map((post: Blog, i: number) => (
								<li class="flex justify-center">
									<a
										href={"/blogs/" + post.slug.current}
										class="card group mx-auto my-4 w-[90vw] rounded-xl bg-white shadow-lg hover:opacity-90 sm:h-[450px] sm:w-auto"
									>
										<figure class="relative">
											<Image
												src={
													i % 2 != 0
														? imageHelper(post.verticalImage).url()
														: imageHelper(post.mainImage).url()
												}
												alt="Blog"
												class={`${i % 2 != 0 ? "h-[450px] w-full rounded-b-xl" : "h-auto w-auto"} rounded-t-xl object-cover group-hover:cursor-pointer`}
												inferSize={true}
											/>
											<div
												class={`${generateClassBasedOnIndex(i)} flex min-h-44 w-full flex-col justify-start rounded-b-xl p-4 sm:p-6`}
											>
												<div class="flex w-full justify-between">
													<p class="mb-3 text-sm font-medium sm:text-base">{post.categories[0]}</p>
													<p class="mb-3 text-sm font-medium sm:text-base">
														{new Date(post.publishedAt).toLocaleDateString("en-US", {
															year: "numeric",
															month: "long",
															day: "numeric",
														})}
													</p>
												</div>
												<p class="font-heading text-lg font-medium leading-tight tracking-wide sm:text-xl md:leading-normal">
													{post.title}
												</p>
											</div>
											<Icon
												name="diagonalArrow"
												class="absolute right-1 top-2 h-auto w-12 sm:right-3 sm:top-3"
											/>
										</figure>
									</a>
								</li>
							))
						}
					</ul>
				</div>
				<!-- Controls -->
				<div
					class="flex h-0 w-full items-center justify-between px-4 py-10"
					data-glide-el="controls"
				>
					<button
						class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-[#beb8e4] text-primary transition duration-300 hover:border-primary focus-visible:outline-none lg:h-16 lg:w-16"
						data-glide-dir="<"
						aria-label="prev slide"
					>
						<Icon name="chevronRight" class="mr-1 rotate-180" size={72} />
					</button>
					<button
						class="inline-flex h-8 w-8 items-center justify-center rounded-full border border-[#beb8e4] text-primary transition duration-300 hover:border-primary focus-visible:outline-none lg:h-16 lg:w-16"
						data-glide-dir=">"
						aria-label="next slide"
					>
						<Icon name="chevronRight" size={72} class="ml-1" />
					</button>
				</div>
			</div>
		</div>

		<script>
			import Glide from "@glidejs/glide";
			var glide06 = new Glide(".glide-06", {
				type: "carousel",
				focusAt: "0",
				breakpoints: {
					640: {
						perView: 1,
					},
					768: {
						perView: 2,
						focusAt: 0,
					},
				},
				startAt: 0,
				perView: 2.5,
				autoplay: false,
				animationDuration: 1000,
				gap: 0,
			});

			if (document.querySelector(".glide-06")) {
				glide06.mount();
			}
		</script>
	</div>
</section>
