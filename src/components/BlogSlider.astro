		</div>

		<script>
			import Glide from "@glidejs/glide";
			var glide06 = new Glide(".glide-06", {
				type: "carousel",
				focusAt: "center",
				breakpoints: {
					640: {
						perView: 1,
					},
					768: {
						perView: 2,
						focusAt: 0,
					},
				},
				startAt: 0,
				perView: 2.5,
				autoplay: false,
				animationDuration: 1000,
				gap: 0,
			});

			if (document.querySelector(".glide-06")) {
				glide06.mount();
			}
		</script>
	</div>
