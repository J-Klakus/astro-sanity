const generateClassBasedOnIndex = (index: number) => {
  if (index % 2 != 0) {
    return "bg-[url('/mesh-card-bg.webp')] bg-no-repeat bg-cover text-white";
  } else {
    return "bg-white text-black";
  }
};
---

<section
  class="bg-[url('/mesh-center-mobile.webp')] sm:bg-[url('/mesh-center.webp')] bg-cover bg-no-repeat bg-[100%_-50%]"
>
  <div class="pb-10">
    <div class="flex justify-between items-center py-2 px-4"></div>
    <div class="relative glide-06">
      <div
        class="flex justify-between gap-4 items-center mb-6 md:mb-10 lg:mb-20 px-4"
      >
        <div class="text-center max-w-2xl mx-auto px-4">
          <p
            class="text-highlight bg-verylight rounded-lg w-fit px-2 py-1 uppercase font-medium tracking-wide mb-3 mx-auto"
          >
            Resources
          </p>
          <h2
            class="font-heading mt-3 text-3xl sm:text-4xl font-medium leading-10 sm:leading-[4rem] tracking-tight text-black"
          >
            Learn from the best
          </h2>
          <p class="my-3 text-lg leading-relaxed text-slate-500">
            Learn how grow your business with our expert
          </p>
          <Button link="#" buttonText="Show More" type="filled" class="w-fit" />
        </div>
