          >
            {
              allBlogPosts.map((post: any, i) => (
                <li class="flex justify-center">
                  <a
                    href={post.slug + "/"}
                    class="card w-[90vw] sm:w-full mx-auto shadow-lg group my-4 rounded-md hover:opacity-90"
