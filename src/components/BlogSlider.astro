                    <figure class="relative">
                      <Image
                        src={post.image}
                        alt="Blog"
                        class="group-hover:cursor-pointer object-cover h-auto w-full rounded-t-xl"
                      />
                      <div
                        class={`${generateClassBasedOnIndex(i)} p-4 sm:p-6 rounded-b-xl w-full flex flex-col justify-start`}
                      >
                        <div class="flex w-full justify-between">
                          <p class="text-sm sm:text-base font-medium mb-3">
                            {post.category}
                          </p>
                          <p class="text-sm sm:text-base font-medium mb-3">
                            {post.date}
                          </p>
                        </div>
                        <p class="[font-size:_clamp(1em,1.2vw,2.5em)] font-medium tracking-wide leading-tight md:leading-normal">
                          {post.title}
                        </p>
                      </div>
                      <Icon
                        name="diagonalArrow"
                        class="absolute top-2 right-1 sm:top-3 sm:right-3 h-auto w-12"
                      />
                    </figure>
                  </a>
                </li>
              ))
            }
          </ul>
