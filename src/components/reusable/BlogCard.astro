---
import { Picture } from "astro:assets";
import imageHelper from "../../utils/imageHelper";
const { blog, index, isAside } = Astro.props;
const {
	publishedAt,
	author,
	categories,
	mainImage,
	verticalImage,
	title,
	slug,
	estimatedReadingTime,
} = blog;
const isRow = index === 1 || index === 5;
---

<a
	class={`${isRow ? "flex-row-reverse md:col-span-2" : "flex-col"} ${isAside ? "h-fit" : "h-[480px]"} flex overflow-hidden rounded-lg shadow transition hover:shadow-lg`}
	href={"/blogs/" + slug.current}
>
	<article
		class={`${isRow ? "flex-row-reverse md:col-span-2" : "flex-col"} ${isAside ? "h-fit" : "h-[480px]"} w-full flex overflow-hidden rounded-lg shadow transition hover:shadow-lg`}
	>
		<div class={`${isRow ? "w-1/2" : isAside ? "h-1/3" : "h-1/2"}`}>
			<Picture
				fallbackFormat="jpg"
				src={isRow ? imageHelper(verticalImage).url() : imageHelper(mainImage).url()}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 40vw, 455px"
				widths={[400, 800, 1200]}
				inferSize={true}
				class={`h-full w-full rounded-lg rounded-b-none object-cover transition duration-300 ease-in-out md:group-hover:brightness-75`}
			/>
		</div>
		<div class={`${isRow ? "w-1/2" : "h-1/2"} bg-white p-4 sm:p-6`}>
			<p class="mb-4 text-sm font-medium uppercase text-primary">{categories}</p>
			<h2
				class={`${isAside ? "text-lg" : "text-2xl"} mb-2 mt-0.5 line-clamp-2 font-heading font-semibold text-gray-900`}
			>
				{title}
			</h2>

			<div class={`${isRow ? "flex-col sm:flex-row" : "flex-row"}  flex gap-4 mt-6`}>
				<Picture
					class="h-16 w-16 rounded-full sm:mr-4"
					src={imageHelper(author.image).url()}
					formats={["avif", "webp"]}
					alt={"author image"}
					sizes="100px"
					widths={[400, 800, 1200]}
					inferSize={true}
				/>
				<div class="text-sm">
					<p class="mb-2 font-medium leading-none text-gray-900">{author.name}</p>
					<p class="mb-2 text-gray-600">
						{
							new Date(publishedAt).toLocaleDateString("en-US", {
								year: "numeric",
								month: "short",
								day: "numeric",
							})
						} · {estimatedReadingTime} min read
					</p>
				</div>
			</div>
		</div>
	</article>
</a>
