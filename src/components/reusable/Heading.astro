---
interface Props {
    title?: string;
    tag?: "h1" | "h2" | "h3" | "h4" | "h5" | "h6" | "p";
    class?: string;
    id?: string;
}

const { title, tag = "h3", class: className = tag, id } = Astro.props;
---

{
    title && (
        <Fragment
            set:html={`<${tag} class="${className}"${id ? ` id="${id}"` : ""}>${title}</${tag}>`}
        />
    )
}
