---
import { Picture, getImage } from "astro:assets";
import candidatepipeline from "../assets/candidate-pipeline.webp";
import Button from "@components/reusable/Button.astro";
import Heading from "@components/reusable/Heading.astro";
import type { ImageRef } from "../utils/imageHelper";
import imageHelper from "../utils/imageHelper";

// Define the interface for the button props
interface ButtonProps {
	link: string;
	buttonText: string;
	type: "filled" | "outline";
	arrow?: boolean;
}

// Define the interface for the component props
interface CustomSectionProps {
	tagline: string;
	first: boolean;
	largeImage: boolean;
	imageSide: "left" | "right";
	title: string;
	titleTag: string;
	description: string;
	button?: ButtonProps[];
	image: ImageRef;
	imageAlt?: string;
}

const {
	tagline = "featured",
	largeImage = false,
	imageSide = "left",
	first = false,
	background = "none",
	title,
	titleTag,
	description,
	button,
	image,
	imageAlt = "A prototype of the app.",
} = Astro.props as CustomSectionProps;
---

<section class=`w-screen vertical-p`>
	>
	<div
		class={`site-container flex flex-col ${imageSide === "left" ? "lg:flex-row-reverse " : "lg:flex-row "} gap-8 lg:gap-20 items-center justify-center mx-auto px-4`}
	>
		<div class={`${largeImage ? "lg:w-2/5" : "lg:w-1/2"} max-w-xl`}>
			<div class="text-center lg:text-start">
				<p
					class="mx-auto my-3 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-primary lg:mx-0"
				>
					{tagline}
				</p>
				{
					(
						<Heading
							title={title}
							tag={titleTag ? titleTag : first ? "h1" : "h2"}
						/>
					)
				}
				<p class="mt-6 leading-relaxed text-slate-500 sm:text-lg">
					{description}
				</p>
			</div>

			<div
				class="mt-6 flex items-center justify-center gap-4 lg:justify-start"
			>
				{
					button &&
						button.length &&
						button.map((button) => (
							<Button
								link={button.link}
								buttonText={button.buttonText}
								type={button.type}
								arrow={button.arrow}
							/>
						))
				}
			</div>
		</div>
		<div
			class={`${largeImage ? "lg:h-full 2xl:h-3/4 w-full h-auto" : "lg:w-1/2 h-auto"} `}
		>
			<Picture
				fallbackFormat="jpg"
				src={imageHelper(image).url()}
				formats={["avif", "webp"]}
				loading={first ? "eager" : "lazy"}
				decoding={first ? "auto" : "async"}
				alt={imageAlt}
				sizes={largeImage
					? "(max-width: 1024px) 100vw, (max-width: 1152px) 60vw, 624px"
					: "(max-width: 1024px) 100vw, (max-width: 1152px) 30vw, 624px"}
				widths={[400, 800, 1200, candidatepipeline.width]}
				class="h-full w-full object-cover object-left"
				inferSize={true}
			/>
		</div>
	</div>
</section>
