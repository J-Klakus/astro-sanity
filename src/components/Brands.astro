---
import Image from "astro/components/Image.astro";
import imageHelper from "../utils/imageHelper";
import type { ImageRef } from "../utils/imageHelper";
const { title, text, images } = Astro.props;
---

<section
	class="bg-[url('/mesh-tr-mobile.webp')] bg-cover bg-no-repeat px-4 sm:bg-[url('/mesh-tr.webp')] sm:py-20"
>
	<div class="mx-auto max-w-7xl py-8 sm:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				{title}
			</h2>
			<p class="mt-3 leading-relaxed text-slate-500 sm:text-lg">
				{text}
			</p>
		</div>
		<ul
			class="relative flex w-full flex-wrap justify-center gap-2 p-0 px-4 py-10 lg:justify-between lg:px-0"
		>
			{
				images.map((image: { image: ImageRef; alt: string }) => {
					return (
						<li class="w-36 md:w-44">
							<div class="flex items-center justify-center">
								<Image
									src={imageHelper(image.image).url()}
									alt={image.alt}
									sizes={"(max-width: 768px) 144px, 176px"}
									widths={[150, 200, 352]}
									class="h-16 object-contain"
									inferSize={true}
								/>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
