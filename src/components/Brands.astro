---
import Image from "astro/components/Image.astro";

const brands = import.meta.glob<{ default: ImageMetadata }>("/src/assets/brands/*");
---

<section
	class="bg-[url('/mesh-tr-mobile.webp')] bg-cover bg-no-repeat px-4 sm:bg-[url('/mesh-tr.webp')] sm:py-20"
>
	<div class="mx-auto max-w-7xl py-8 sm:py-24">
		<div class="mx-auto max-w-2xl text-center">
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				You’ll be in good company
			</h2>
			<p class="mt-3 text-lg leading-relaxed text-slate-500">
				Join the community of leading recruitment agencies using our solutions for unmatched
				results.
			</p>
		</div>
		<ul class="relative flex w-full flex-wrap justify-between gap-2 p-0 px-4 py-10 lg:px-0">
			{
				Object.keys(brands).map(async (image) => {
					const src = (await brands[image]()).default;
					return (
						<li class="w-44">
							<div class="flex items-center justify-center p-2">
								<Image
									src={src}
									alt={image.split("/")[3].split(".")[0] + " logo"}
									class="h-16 object-contain"
								/>
							</div>
						</li>
					);
				})
			}
		</ul>
	</div>
</section>
