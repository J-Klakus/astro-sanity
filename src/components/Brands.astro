---
import Image from "astro/components/Image.astro";
import { getImage } from "astro:assets";
import myBackground from "../assets/meshbg.webp";

const brands = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/brands/*"
);
---

<section
  class="bg-[url('/mesh-tr-mobile.webp')] sm:bg-[url('/mesh-tr.webp')] bg-no-repeat bg-[length:100%_100%]"
>
  <div class="mx-auto max-w-7xl py-8 sm:py-40 px-4">
    <div class="text-center max-w-2xl mx-auto">
      <h2
        class="font-heading mt-3 text-3xl sm:text-4xl font-bold leading-10 sm:leading-[4rem] tracking-tight text-black"
      >
        You’ll be in good company
      </h2>
      <p class="mt-3 text-lg leading-relaxed text-slate-500">
        Join the community of leading recruitment agencies using our solutions
        for unmatched results.
      </p>
    </div>
    <ul
      class="relative w-full p-0 flex flex-wrap justify-evenly gap-2 px-4 py-10"
    >
      {
        Object.keys(brands).map(async (image) => {
          const src = (await brands[image]()).default;
          return (
            <li class="w-44">
              <div class="flex justify-center items-center p-2">
                <Image
                  src={src}
                  alt={image.split("/")[3].split(".")[0] + " logo"}
                  class="object-contain h-16"
                />
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
