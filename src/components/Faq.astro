---
import { Icon } from "astro-icon/components";

const { faq } = Astro.props;
---

<section class="flex flex-col bg-gradient-to-b md:flex-row">
	<div class="mx-auto min-h-screen max-w-7xl">
		<div class="p-4">
			<h2 class="my-16 text-center font-heading text-4xl font-medium leading-10 sm:text-3xl">
				Frequently Asked Questions
			</h2>
			<div class="grid items-start gap-y-10 lg:grid-cols-2">
				{
					faq.map((item: { title: string; text: string }) => (
						<div class="group h-fit">
							{/* header */}
							<div
								aria-expanded="false"
								class="faq-header group flex h-16 cursor-pointer items-center space-x-5 transition md:px-5"
							>
								<Icon name="question" size={30} />
								<h2 class="inline-block font-heading font-medium text-gray-500 group-hover:text-primary group-aria-expanded:text-gray-900 sm:text-xl">
									{item.title}
								</h2>
								<Icon
									name="chevronDown"
									class="transition-transform duration-300 ease-in-out group-aria-expanded:rotate-180"
									size={20}
								/>
							</div>
							{/* Content */}
							<div class="faq-content mb-2 ml-4 h-fit max-h-0 w-11/12 overflow-hidden border-y border-y-neutral-200 px-5 pl-6 pt-0 text-slate-500 md:ml-4 md:pl-9">
								<p class="py-6 text-justify font-light leading-6">{item.text}</p>
							</div>
						</div>
					))
				}
			</div>
		</div>
	</div>
</section>

<style>
	.faq-content {
		transition:
			max-height 0.3s ease-out,
			padding 0.3s ease;
	}
</style>

<script>
	document.addEventListener("DOMContentLoaded", function () {
		const faqHeaders = document.querySelectorAll(".faq-header") as NodeListOf<HTMLElement>;

		faqHeaders.forEach((header, index) => {
			const faqContent = header.parentElement?.querySelector(".faq-content") as HTMLElement;
			header.setAttribute("aria-expanded", "false");
			faqContent.style.maxHeight = "0px"; // Ensure content is initially hidden

			header.addEventListener("click", function () {
				const currentlyOpenFaq = document.querySelector(
					".faq-content[style*='max-height']:not([style*='max-height: 0px'])",
				) as HTMLElement;

				// Close the currently open faq content if it exists and is not the one being clicked
				if (currentlyOpenFaq && currentlyOpenFaq !== faqContent) {
					currentlyOpenFaq.style.maxHeight = `0px`;
					currentlyOpenFaq.parentElement
						?.querySelector(".faq-header")
						?.setAttribute("aria-expanded", "false");
				}

				// Toggle the clicked faq content
				let faqMaxHeight = faqContent.style.maxHeight;
				if (faqMaxHeight === "0px" || faqMaxHeight.length === 0) {
					faqContent.style.maxHeight = `${faqContent.scrollHeight}px`;
					header.setAttribute("aria-expanded", "true");
				} else {
					faqContent.style.maxHeight = `0px`;
					header.setAttribute("aria-expanded", "false");
				}
			});
		});
	});
</script>
