import { Picture } from "astro:assets";
import features from "../assets/features.webp";
import { Icon } from "astro-icon/components";

type ListItem = {
	text: string;
};

type FeatureItem = {
	icon: string;
	title: string;
	list: ListItem[];
	link: string;
};

type Features = {
	title: string;
	header: string;
	items: FeatureItem[];
};

