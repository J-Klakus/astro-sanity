const { items, title, header } = Astro.props as Features;
---

<section class="flex flex-col bg-gradient-to-b from-[#edebf8] via-white to-[#e5fcf8] md:flex-row">
	<div class="grid place-items-start md:w-3/5">
		<div class="mx-auto md:ml-[12%]">
			<div class="p-4">
				<p
					class="my-3 w-fit rounded-lg px-2 py-1 font-medium uppercase tracking-wide text-highlight"
				>
					{header}
				</p>
				<h2 class="font-heading text-4xl font-medium leading-10 sm:text-3xl">
					{title}
				</h2>
				<div class="mx-auto my-5 h-1 w-full border-b"></div>
				{
					items.map((item: FeatureItem, index: number) => (
						<div class="group transition">
							{/* header */}
							<div class="accordion-header flex h-16 cursor-pointer items-center space-x-5 transition md:px-5">
								<Icon name={item.icon} size={30} />
								<h2 class="inline-block bg-text-gradient bg-[length:200%_200%] bg-clip-text font-heading text-2xl font-medium text-transparent group-hover:animate-text group-hover:text-[rgba(0,0,0,0)]">
									{item.title}
								</h2>
							</div>
							{/* Content */}
							<ul class="accordion-content mb-2 ml-4 max-h-0 list-outside list-disc space-y-2 overflow-hidden border-l border-l-neutral-400 px-5 pl-6 pt-0 text-xl tracking-normal text-slate-500 md:ml-9 md:pl-9">
								{item.list.map((listItem, i) => (
									<li class="py-2">{listItem.text}</li>
								))}
								<li class="my-3 list-none text-primary">
									<a href={item.link}>Learn more</a>
								</li>
							</ul>
						</div>
					))
				}
			</div>
		</div>
	</div>
	<div class="max-w-7xl md:-mt-6 md:w-2/5">
		<Picture
			fallbackFormat="jpg"
			src={features}
			formats={["avif", "webp"]}
			alt="A prototype of the app."
			sizes="(max-width: 768px) 100vw, 50vw"
			widths={[400, 800, 1200, features.width]}
			class="h-auto w-full object-cover object-left shadow-[rgba(0,_0,_0,_0.1)_0px_24px_30px_-10px]"
		/>
	</div>

	<style>
		.accordion-content {
			transition:
				max-height 0.3s ease-out,
				padding 0.3s ease;
		}
	</style>
</section>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		const accordionHeaders = document.querySelectorAll(
			".accordion-header",
		) as NodeListOf<HTMLElement>;

		accordionHeaders.forEach((header, index) => {
			header.addEventListener("click", function () {
				const accordionContent = header.parentElement?.querySelector(
					".accordion-content",
				) as HTMLElement;
				const currentlyOpenAccordion = document.querySelector(
					".accordion-content[style*='max-height']:not([style*='max-height: 0px'])",
				) as HTMLElement;

				// Close the currently open accordion content if it exists and is not the one being clicked
				if (currentlyOpenAccordion && currentlyOpenAccordion !== accordionContent) {
					currentlyOpenAccordion.style.maxHeight = `0px`;
				}

				// Toggle the clicked accordion content
				let accordionMaxHeight = accordionContent.style.maxHeight;
				if (accordionMaxHeight === "0px" || accordionMaxHeight.length === 0) {
					accordionContent.style.maxHeight = `${accordionContent.scrollHeight + 32}px`;
				} else {
					accordionContent.style.maxHeight = `0px`;
				}
			});

			// Open the first item by default
			if (index === 0) {
				header.click();
			}
		});
	});
</script>
