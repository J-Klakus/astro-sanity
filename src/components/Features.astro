---
import features from "../assets/features.webp";
import { Icon } from "astro-icon/components";
import { Image, Picture, getImage } from "astro:assets";
import imageHelper from "../utils/imageHelper";
import type { ImageRef } from "../utils/imageHelper";

type ListItem = {
	text: string;
};

type FeatureItem = {
	icon: string;
	title: string;
	list: ListItem[];
	link: string;
	image: ImageRef;
};

type Features = {
	title: string;
	header: string;
	items: FeatureItem[];
};
const { items, title, header } = Astro.props as Features;
---

<section
	class="bg-gradient-to-b from-[#f9f8fd] via-white to-[#e5fcf8] md:flex-row lg:from-[#f2f2fb] lg:to-[#ebfafa]"
>
	<div class="ml-auto flex max-w-7xl flex-col md:flex-row md:justify-between">
		<div class="grid place-items-start md:w-1/2">
			<div class="mx-auto">
				<div class="p-4">
					<p
						class="my-3 w-fit rounded-lg px-2 py-1 font-medium uppercase tracking-wide text-highlight"
					>
						{header}
					</p>
					<h2 class="mb-5 font-heading text-4xl font-medium leading-10 sm:text-3xl">
						{title}
					</h2>
					{
						items.map(async (item: FeatureItem, index: number) => (
							<div>
								{/* header */}
								<div
									tabindex="0"
									data-image={
										item.image
											? await (
													await getImage({
														src: imageHelper(item.image).url(),
														format: "webp",
														inferSize: true,
													})
												).src
											: features.src
									}
									class="accordion-header group flex h-16 cursor-pointer items-center space-x-5 transition md:px-5"
								>
									<Icon name={item.icon} size={30} />
									<h2 class="inline-block bg-text-gradient bg-[length:200%_200%] bg-clip-text font-heading text-2xl font-medium text-transparent hover:bg-right group-aria-expanded:bg-right group-aria-expanded:text-[rgba(0,0,0,0)]">
										{item.title}
									</h2>
								</div>
								{/* Content */}
								<ul class="accordion-content mb-2 ml-4 max-h-0 max-w-lg list-outside list-disc space-y-2 overflow-hidden border-l border-l-neutral-400 px-5 pl-6 pt-0 tracking-normal text-slate-500 sm:text-lg md:ml-9 md:pl-9">
									{item.list.map((listItem, i) => (
										<li class="py-2">{listItem.text}</li>
									))}
									<li class="my-3 list-none text-primary">
										<a href={item.link}>Learn more</a>
									</li>
								</ul>
							</div>
						))
					}
				</div>
			</div>
		</div>
		<div class="md:h-screen md:w-1/2">
			<Image
				id="featuresImage"
				src={features}
				alt="A prototype of the app."
				loading="eager"
				class="top-20 h-auto w-full object-cover object-left transition-opacity duration-300 ease-in-out md:sticky"
			/>
		</div>

		<style>
			.accordion-content {
				transition:
					max-height 0.3s ease-out,
					padding 0.3s ease;
			}
		</style>
	</div>
</section>
<script>
	document.addEventListener("DOMContentLoaded", function () {
		const image = document.getElementById("featuresImage") as HTMLImageElement;
		const accordionHeaders = document.querySelectorAll(
			".accordion-header",
		) as NodeListOf<HTMLElement>;

		accordionHeaders.forEach((header, index) => {
			header.addEventListener("click", function () {
				const accordionContent = header.parentElement?.querySelector(
					".accordion-content",
				) as HTMLElement;
				const currentlyOpenAccordion = document.querySelector(
					".accordion-content[style*='max-height']:not([style*='max-height: 0px'])",
				) as HTMLElement;

				// Close the currently open accordion content if it exists and is not the one being clicked
				if (currentlyOpenAccordion && currentlyOpenAccordion !== accordionContent) {
					currentlyOpenAccordion.style.maxHeight = `0px`;
					const openHeader = currentlyOpenAccordion.previousElementSibling as HTMLElement;
					if (openHeader) openHeader.setAttribute("aria-expanded", "false");
				}
				if (header) {
					// Fade out the current image
					image.style.opacity = "0";
					setTimeout(() => {
						// Change the image src
						image.src = header.getAttribute("data-image") as string;
						// Fade in the new image
						image.style.opacity = "1";
					}, 300); // Ensure this delay matches the transition duration in CSS
				}

				// Toggle the clicked accordion content
				let accordionMaxHeight = accordionContent.style.maxHeight;
				if (accordionMaxHeight === "0px" || accordionMaxHeight.length === 0) {
					accordionContent.style.maxHeight = `${accordionContent.scrollHeight + 32}px`;
					header.setAttribute("aria-expanded", "true");
				} else {
					accordionContent.style.maxHeight = `0px`;
					header.setAttribute("aria-expanded", "false");
				}
			});

			// Set initial ARIA attributes
			header.setAttribute("aria-expanded", "false");

			// Open the first item by default
			if (index === 0) {
				header.click();
			}
		});

		const imageSources: string[] = Array.from(accordionHeaders)
			.map((header) => header.getAttribute("data-image"))
			.filter((src): src is string => src !== null);
		const preload = async () => {
			await Promise.all(
				imageSources.map(
					(a) =>
						new Promise((res) => {
							const preloadImage = new Image();
							preloadImage.onload = res;
							preloadImage.src = a;
						}),
				),
			);
		};
		preload();
	});
</script>
