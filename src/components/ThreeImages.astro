---
import browser from "../assets/browser-purple.webp";
import website from "../assets/website-purple.webp";
import email from "../assets/email-purple.webp";
import { Picture } from "astro:assets";
import Pill from "./Pill.astro";

const {
	header = "Features",
	title = "Discover more tools to boost your productivity",
	descriptions = [
		{
			pillText: "Website Widget",
			text: "This widget seamlessly integrates with your website, allowing you to display open positions. It enables potential candidates to view and apply to jobs directly from your site.",
		},
		{
			pillText: "Email Integration",
			text: "Our CV parser employs AI to sift through resumes and extract key information. Seamlessly integrated into our system, it scans your inbox for resumes, offering you the option to parse them effortlessly.",
		},
		{
			pillText: "Browser Extension",
			text: "Airhire automatically syncs with your email for a smoother recruitment experience. Send and receive emails directly from your Airhire dashboard.",
		},
	],
} = Astro.props;
---

<section class="mx-auto overflow-hidden pt-8 md:pt-20 lg:max-w-7xl">
	<div class="mx-auto max-w-4xl px-4 text-center lg:px-0">
		<p
			class="mx-auto mb-3 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
		>
			{header}
		</p>
		<h2
			class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black md:text-4xl md:leading-[4rem]"
		>
			{title}
		</h2>
	</div>
	<div class="mx-auto grid grid-cols-1 gap-4 px-4 py-8 md:grid-cols-3">
		<a
			href={descriptions[0].pillText.toLowerCase().replaceAll(" ", "-")}
			class="group relative mx-auto max-w-xs rounded-xl hover:cursor-pointer sm:max-w-2xl md:max-w-none"
		>
			<Picture
				fallbackFormat="jpg"
				src={website}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
				widths={[400, 800, website.width]}
				class="h-auto w-full rounded-xl object-contain transition duration-300 ease-in-out md:group-hover:brightness-75"
			/>
			<Pill text={descriptions[0].pillText} position="top-left" />
			<div
				class="bg-purple-gradient absolute bottom-0 flex h-fit w-full flex-col justify-end rounded-xl p-6"
			>
				<p class="text-lg leading-tight text-white md:leading-normal">
					{descriptions[0].text}
				</p>
			</div>
		</a>
		<a
			href={descriptions[1].pillText.toLowerCase().replaceAll(" ", "-")}
			class="group relative mx-auto max-w-xs rounded-xl hover:cursor-pointer sm:max-w-2xl md:max-w-none"
		>
			<Picture
				fallbackFormat="jpg"
				src={email}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
				widths={[400, 800, email.width]}
				class="h-auto w-full rounded-xl object-contain transition duration-300 ease-in-out md:group-hover:brightness-75"
			/>
			<div
				class="bg-purple-gradient absolute bottom-0 flex h-fit w-full flex-col justify-end rounded-xl p-6"
			>
				<p class="text-lg leading-tight text-white md:leading-normal">
					{descriptions[1].text}
				</p>
			</div>
			<Pill text={descriptions[1].pillText} position="top-left" />
		</a>
		<a
			href={descriptions[2].pillText.toLowerCase().replaceAll(" ", "-")}
			class="group relative mx-auto max-w-xs rounded-xl hover:cursor-pointer sm:max-w-2xl md:max-w-none"
		>
			<Picture
				fallbackFormat="jpg"
				src={browser}
				formats={["avif", "webp"]}
				alt={"infographic"}
				sizes="(max-width: 768px) 100vw, (max-width: 1298px) 30vw, 455px"
				widths={[400, 800, browser.width]}
				class="h-auto w-full rounded-xl object-contain transition duration-300 ease-in-out md:group-hover:brightness-75"
			/>
			<div
				class="bg-purple-gradient absolute bottom-0 flex h-fit w-full flex-col justify-end rounded-xl p-6"
			>
				<p class="text-lg leading-tight text-white md:leading-normal">
					{descriptions[2].text}
				</p>
			</div>
			<Pill text={descriptions[2].pillText} position="top-left" />
		</a>
	</div>
</section>
