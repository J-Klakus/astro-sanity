---
import { Picture } from "astro:assets";
import logobig from "../assets/logobig.webp";
import Button from "./reusable/Button.astro";
---

<section
  class="bg-[url('/bg-bottom-mobile.webp')] sm:bg-[url('/bg-bottom.webp')] bg-cover bg-no-repeat bg-[center_bottom_-3rem] flex flex-col justify-center"
>
  <div
    class="flex flex-col-reverse md:flex-row justify-between items-center my-[7vw] bg-white border border-verylight w-[90vw] md:w-full md:max-w-7xl mx-auto"
  >
    <div class="flex flex-col p-8">
      <h2
        class="text-2xl md:text-4xl/normal md:w-5/6 pb-1 font-heading group-hover:to-primary bg-text-gradient to-primary inline-block text-transparent font-bold bg-clip-text"
      >
        Discover our competitive offer tailored to recruitment agencies.
      </h2>
      <Button
        link="#"
        buttonText="Show Pricing"
        type="filled"
        class="w-fit mt-8"
      />
    </div>
    <div class="h-full w-auto">
      <Picture
        fallbackFormat="jpg"
        src={logobig}
        formats={["avif", "webp"]}
        alt="A prototype of the app."
        widths={[400, 800, 1200, logobig.width]}
        loading="eager"
        class="h-auto w-10/12 object-contain pt-2 md:pt-0"
      />
    </div>
  </div>
</section>
