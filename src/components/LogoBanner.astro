---
import { Picture } from "astro:assets";
import logobig from "../assets/logobig.webp";
import Button from "./reusable/Button.astro";
---

<section
	class="flex flex-col justify-center bg-[url('/bg-bottom-mobile.webp')] bg-cover bg-[center_bottom_-3rem] bg-no-repeat sm:bg-[url('/bg-bottom.webp')] lg:py-12"
>
	<div
		class="mx-auto my-[7vw] flex w-[90vw] flex-col-reverse items-center justify-between border border-verylight bg-white md:w-full md:max-w-7xl md:flex-row"
	>
		<div class="flex flex-col p-8">
			<h2
				class="inline-block bg-text-gradient to-primary bg-clip-text pb-1 font-heading text-2xl font-medium text-transparent group-hover:to-primary md:w-5/6 md:text-4xl/normal"
			>
				Discover our competitive offer tailored to recruitment agencies.
			</h2>
			<Button link="#" buttonText="Show Pricing" type="filled" class="mt-8 w-fit" />
		</div>
		<div class="h-full w-auto">
			<Picture
				fallbackFormat="jpg"
				src={logobig}
				formats={["avif", "webp"]}
				alt="A prototype of the app."
				widths={[400, 800, 1200, logobig.width]}
				loading="eager"
				class="h-auto w-10/12 object-contain pt-2 md:pt-0"
			/>
		</div>
	</div>
</section>
