---
import { Picture } from "astro:assets";
import Button from "./reusable/Button.astro";
import imageHelper from "../utils/imageHelper";

const { header, title, text, cards } = Astro.props;
---

<div
	class="bg-[url('/bg-center-mobile.webp')] bg-cover bg-[center_bottom_-10rem] bg-no-repeat pb-8 sm:bg-[url('/bg-center.webp')] sm:pb-40"
>
	<div class="mx-auto grid max-w-7xl place-items-center gap-4 px-4 lg:grid-cols-7">
		<div class="col-span-3 mx-auto mb-8 flex max-w-xl flex-col">
			<p
				class="my-1 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
			>
				{header}
			</p>
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				{title}
			</h2>
			<p class="my-6 leading-relaxed text-slate-500 sm:text-lg">
				{text}
			</p>
			<Button link="/sign-up" buttonText="Try For Free" type="filled" class="w-fit" arrow={true} />
		</div>
		<div class="col-span-4 mx-auto grid w-full max-w-3xl grid-cols-1 gap-4 sm:grid-cols-2">
			<div class="relative">
				<Picture
					fallbackFormat="jpg"
					src={imageHelper(cards[0].image).url()}
					formats={["avif", "webp"]}
					alt={cards[0].imageAlt}
					sizes="(max-width: 1024px) 50vw, (max-width: 1020px) 50vw, 400px"
					widths={[400, 800]}
					inferSize={true}
					class="h-auto w-full shadow-[rgba(0,_0,_0,_0.1)_0px_24px_30px_-10px]"
				/>
				<div
					class="absolute bottom-0 flex h-fit w-full flex-col justify-end rounded-b-xl bg-[url('/mesh-card-bg.webp')] bg-cover bg-no-repeat p-6"
				>
					<p class="mb-1 !leading-none text-white [font-size:_clamp(2em,4.75vw,4.5em)]">
						{cards[0].percentage}
					</p>
					<div class="mb-2 h-[2px] w-full bg-gradient-to-r from-[#4B3AB3] to-[#9FFFF3]"></div>
					<p
						class="leading-tight text-white [font-size:_clamp(1.25em,1.25vw,1.125em)] md:leading-normal"
					>
						{cards[0].description}
					</p>
				</div>
			</div>
			<div class="relative">
				<Picture
					fallbackFormat="jpg"
					src={imageHelper(cards[1].image).url()}
					formats={["avif", "webp"]}
					alt={cards[1].imageAlt}
					sizes="(max-width: 1024px) 50vw, (max-width: 1020px) 50vw, 400px"
					widths={[400, 800]}
					inferSize={true}
					class="h-auto w-full shadow-[rgba(0,_0,_0,_0.1)_0px_24px_30px_-10px]"
				/>
				<div
					class="absolute bottom-0 flex h-fit w-full flex-col justify-end rounded-b-xl bg-[url('/mesh-card-bg.webp')] bg-cover bg-center bg-no-repeat p-6 md:top-0 md:rounded-t-xl"
				>
					<p class="mb-1 !leading-none text-white [font-size:_clamp(2em,4.75vw,4.5em)]">
						{cards[1].percentage}
					</p>
					<div class="mb-2 h-[2px] w-full bg-gradient-to-r from-[#4B3AB3] to-[#9FFFF3]"></div>
					<p
						class="leading-tight text-white [font-size:_clamp(1.25em,1.25vw,1.125em)] md:leading-normal"
					>
						{cards[1].description}
					</p>
				</div>
			</div>
		</div>
	</div>
</div>
