---
import { Picture, getImage } from "astro:assets";
import Button from "./reusable/Button.astro";
import Video from "./Video.astro";

const { title, text } = Astro.props;
---

<section
	class="flex flex-col items-center justify-center gap-8 bg-[#fafafe] bg-[url('/bg-hero-mobile.webp')] bg-auto bg-bottom bg-no-repeat pb-16 pt-36 md:bg-[url('/bg-hero.webp')] md:bg-[center_top_10rem] md:pb-36 lg:gap-20"
>
	<div class="mx-auto max-w-3xl px-4 lg:px-0">
		<div class="text-center">
			<h1
				class="font-heading text-4xl font-medium leading-normal text-gray-900 sm:text-[54px] sm:leading-[4rem]"
			>
				{title}
			</h1>
			<p class="mt-6 leading-relaxed text-slate-500 sm:text-xl">{text}</p>
		</div>

		<div class="mt-6 flex items-center justify-center gap-4 lg:gap-8">
			<Button link="/sign-up" buttonText="Try for free" type="filled" />
			<Button link="/sign-up" buttonText="Request a demo" type="outline" arrow={true} />
		</div>
	</div>
	<div class="max-w-4xl">
		<Video video="./video.mov" />
	</div>
</section>
