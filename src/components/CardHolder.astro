---
import { getImage } from "astro:assets";
import { Icon } from "astro-icon/components";

const cards = [
  {
    name: "Browser Extension",
    description:
      "Easily source top talent directly from professional networks like LinkedIn, Outlook, Gmail, Xing, and more.",
    icon: "browser",
    link: "/",
  },
  {
    name: "Website Widget",
    description:
      "Enhance your company's career page with a customizable widget. Display open positions and allow candidates to apply directly from your site.",
    icon: "website",
    link: "/",
  },
  {
    name: "CV Parser",
    description:
      "Save time by automatically extracting key information from resumes with our AI-powered CV parser. Seamlessly integrated into your workflow.",
    icon: "cv",
    link: "/",
  },
  {
    name: "Email Integration",
    description:
      "Airhire automatically syncs with your email for a smoother recruitment experience. Send and receive emails directly from your Airhire dashboard.",
    icon: "email",
    link: "/",
  },
];
---

<section class="px-4 lg:px-0">
  <div class="text-center max-w-2xl mx-auto px-4">
    <p
      class="text-highlight bg-verylight rounded-lg w-fit px-2 py-1 uppercase font-medium tracking-wide mb-3 mx-auto"
    >
      Features
    </p>
    <h2
      class="font-heading mt-3 text-3xl sm:text-4xl font-medium leading-10 sm:leading-[4rem] tracking-tight text-black"
    >
      Work more efficiently with Airhire
    </h2>
    <p class="mt-3 text-lg leading-relaxed text-slate-500">
      Explore our tailored 360-degree solution to gain speed, boost productivity
      and match all your agency’s unique recruitment needs.
    </p>
  </div>
  <div
    class="grid lg:grid-cols-4 sm:grid-cols-2 grid-cols-1 gap-4 max-w-7xl mx-auto px-6 md:px-0"
  >
    {
      cards.map((card) => (
        <div class="group flex flex-col justify-between p-6 my-2 sm:my-14 bg-gradient-to-b from-[#735DF6] to-primary to-[0%] hover:to-[100%] transition duration-300 ease-in-out rounded-xl h-[400px]">
          <Icon name={card.icon} size={30} class="text-white" />
          <div>
            <h2 class="text-xl font-medium text-white ">{card.name}</h2>
            <p class="mt-3 text-lg leading-relaxed text-white">
              {card.description}
            </p>
          </div>
          <a href={card.link}>
            <button class="inline-flex items-center text-white">
              Learn More{" "}
              <Icon
                name="arrowRight"
                class="ml-2 ease-in-out text-white group-hover:ml-4 transition-all duration-300 "
              />
            </button>
          </a>
        </div>
      ))
    }
  </div>
</section>
