---
import { Icon } from "astro-icon/components";
import Button from "./reusable/Button.astro";

interface Card {
	name: string;
	description: string;
	icon: string;
	link: string;
}

const defaultCards = [
	{
		name: "Browser Extension",
		description:
			"Easily source top talent directly from professional networks like LinkedIn, Outlook, Gmail, Xing, and more.",
		icon: "browser",
		link: "/browser-extension",
	},
	{
		name: "Website Widget",
		description:
			"Enhance your company's career page with a customizable widget. Display open positions and allow candidates to apply directly from your site.",
		icon: "website",
		link: "/website-widget",
	},
	{
		name: "CV Parser",
		description:
			"Save time by automatically extracting key information from resumes with our AI-powered CV parser. Seamlessly integrated into your workflow.",
		icon: "cv",
		link: "/cv",
	},
	{
		name: "Email Integration",
		description:
			"Airhire automatically syncs with your email for a smoother recruitment experience. Send and receive emails directly from your Airhire dashboard.",
		icon: "email",
		link: "/email-integration",
	},
];

let {
	cards,
	title = "Work more efficiently with Airhire",
	subTitle = "Explore our tailored 360-degree solution to gain speed, boost productivity and match all your agency's unique recruitment needs.",
	header = "featured",
	button,
} = Astro.props;

if (!cards) {
	cards = defaultCards;
}
---

<section class="px-4">
	<div class="mx-auto my-4 flex max-w-2xl flex-col justify-center text-center sm:my-0">
		<p
			class="mx-auto mb-3 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
		>
			{header}
		</p>
		<h2
			class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
		>
			{title}
		</h2>
		<p class="mt-3 leading-relaxed text-slate-500 sm:text-lg">
			{subTitle}
		</p>
		{button && <Button link={button.link} buttonText={button.buttonText} type={button.type} />}
	</div>
	<div
		class="my-4 flex snap-x snap-mandatory gap-4 overflow-y-scroll sm:mx-auto sm:my-14 sm:grid sm:max-w-7xl sm:grid-cols-2 sm:overflow-y-auto xl:grid-cols-4"
	>
		{
			cards.map((card: Card) => (
				<div class="group mx-auto my-2 flex h-[400px] w-72 max-w-xs shrink-0 snap-start snap-always flex-col justify-between rounded-xl bg-primary bg-gradient-to-b from-[#735DF6] to-primary to-[100%] p-6 bg-blend-color transition duration-300 ease-in-out hover:bg-transparent sm:w-auto">
					<a href={card.link}>
						<Icon name={card.icon} size={30} class="text-white" />
						<div class="mt-8">
							<h2 class="text-2xl font-medium text-white">{card.name}</h2>
							<p class="mt-3 text-base leading-relaxed text-white">{card.description}</p>
						</div>
						{card.link && (
							<a href={card.link}>
								<button class="inline-flex items-center text-white underline-offset-8 transition duration-300 ease-in-out hover:underline">
									Learn More{" "}
									<Icon
										name="arrowRight"
										class="ml-2 text-white transition-all duration-300 ease-in-out group-hover:ml-4"
									/>
								</button>
							</a>
						)}
					</a>
				</div>
			))
		}
	</div>
</section>
