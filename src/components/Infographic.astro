---
import { Picture } from "astro:assets";
import Button from "./reusable/Button.astro";
import info from "../assets/infographic.webp";
---

<div class="px-4 py-8 sm:pb-20">
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto mb-8 flex max-w-2xl flex-col text-center">
			<p
				class="mx-auto my-1 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
			>
				Features
			</p>
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				AI candidate matching at your fingertips
			</h2>
			<p class="my-3 text-lg leading-relaxed text-slate-500">
				Our advanced AI search capabilities allow you to precisely look for specific candidates like
				a CFO involved in an IPO, improving placement rates and candidate quality without bias.
			</p>
			<Button link="#" buttonText="Learn More" type="filled" class="mx-auto w-fit" />
		</div>
		<Picture
			fallbackFormat="jpg"
			src={info}
			formats={["avif", "webp"]}
			alt="A prototype of the app."
			sizes="(max-width: 1280px) 100vw, 1200px"
			widths={[400, 800, 1400, info.width]}
			class="my-4 h-full w-auto"
		/>
	</div>
</div>
