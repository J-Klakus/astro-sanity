---
import { Picture } from "astro:assets";
import Button from "./reusable/Button.astro";
import imageHelper from "../utils/imageHelper";
import type { ImageRef } from "../utils/imageHelper";

type Props = {
	title: string;
	header: string;
	text: string;
	image: ImageRef;
	mobileImage: ImageRef;
	button: { link: string; buttonText: string; type: "filled" | "outline"; arrow: boolean };
};

const { title, header, text, image, button, mobileImage } = Astro.props;
---

<div class="px-4 py-8 sm:pb-20">
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto mb-8 flex max-w-3xl flex-col text-center">
			<p
				class="mx-auto my-1 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-primary"
			>
				{header}
			</p>
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				{title}
			</h2>
			<p class="mx-auto mb-6 mt-3 max-w-2xl leading-relaxed text-slate-500 sm:text-lg">
				{text}
			</p>
			<Button
				link={button.link}
				buttonText={button.buttonText}
				type={button.type}
				arrow={button.arrow}
				class="mx-auto w-fit"
			/>
		</div>
		<Picture
			fallbackFormat="jpg"
			src={imageHelper(image).url()}
			formats={["avif", "webp"]}
			alt="A prototype of the app."
			sizes="(max-width: 1280px) 100vw, 1400px"
			widths={[400, 800, 1400, 1800]}
			inferSize={true}
			class="my-4 hidden h-auto w-full sm:block"
		/>
		<Picture
			fallbackFormat="jpg"
			src={imageHelper(mobileImage).url()}
			formats={["avif", "webp"]}
			alt="A prototype of the app."
			sizes="(max-width: 1280px) 100vw, 1400px"
			widths={[400, 800, 1400, 1800]}
			inferSize={true}
			class="my-4 h-auto w-full sm:hidden"
		/>
	</div>
</div>
