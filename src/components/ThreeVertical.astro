---
import Button from "./reusable/Button.astro";
import { Icon } from "astro-icon/components";
---

<section
	class="bg-[url('/bg-mobile.webp')] bg-cover bg-top bg-no-repeat pb-20 sm:bg-[url('/bg-spots-double.webp')]"
>
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto flex flex-col items-center justify-center gap-8 px-4 lg:flex-row">
			<div class="lg:2/5 max-w-xl">
				<div class="text-center lg:text-start">
					<h2
						class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-normal"
					>
						Designed for recruitment agencies
					</h2>
					<p class="mt-6 leading-relaxed text-slate-500 sm:text-lg">
						Airhire has been developed by seasoned recruiters together with AI experts to combine
						industry expertise and create powerful platform designed with recruitment agencies in
						mind.
					</p>
				</div>

				<div class="mt-6 flex items-center justify-center gap-4 lg:justify-start">
					<Button link="/sign-up" buttonText="Get Started" type="filled" arrow={true} />
				</div>
			</div>
			<div class="h-auto w-full lg:h-full lg:w-3/5">
				<div class="flex flex-col gap-8 rounded-lg bg-white/70 p-8 backdrop-blur-lg">
					<div class="flex flex-col pt-2 sm:flex-row">
						<div>
							<Icon name="dots" width={120} height={120} class="mt-6 block" />
						</div>
						<div>
							<h2 class="mb-2 mt-0.5 font-heading text-2xl font-semibold text-gray-900">
								StartUps
							</h2>
							<p class="leading-tight text-gray-500 md:leading-normal">
								Leverage powerful features without breaking the bank. Airhire understands the
								fast-paced nature of startups and and focuses on helping your business scale.
								Airhire is easy-to-use, highly customisable, and intuitive.
							</p>
						</div>
					</div>
					<div class="flex flex-col border-t border-t-gray-300 pt-2 sm:flex-row">
						<div>
							<Icon name="dots5" width={120} height={120} class="mt-6 block" />
						</div>
						<div>
							<h2 class="mb-2 mt-0.5 font-heading text-2xl font-semibold text-gray-900">
								Small sized recruitment agencies
							</h2>
							<p class="leading-tight text-gray-500 md:leading-normal">
								Increase your team's productivity with Airhire. Airhire simplifies sourcing,
								automates tasks and finds top talent quickly with AI, freeing up your team to focus
								on client- and candidate relationships, and providing exceptional service.
							</p>
						</div>
					</div>
					<div class="flex flex-col border-t border-t-gray-300 pt-2 sm:flex-row">
						<div>
							<Icon name="dotsfull" width={120} height={120} class="mt-6 block" />
						</div>
						<div>
							<h2 class="mb-2 mt-0.5 font-heading text-2xl font-semibold text-gray-900">
								Mid sized recruitment agencies
							</h2>
							<p class="leading-tight text-gray-500 md:leading-normal">
								Don't settle for average results. Airhire’s all-in-one solution helps mid-sized
								agencies compete with larger players by streamlining workflows and enhancing
								collaboration. AI automates time-consuming tasks such as candidate screening and
								interview scheduling for high-volume recruitment.
							</p>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</section>
