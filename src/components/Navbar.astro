---
import Button from "./reusable/Button.astro";
import { Icon } from "astro-icon/components";
import { sanityClient } from "sanity:client";

interface MenuItem {
	title: string;
	link: string;
	values?: { text: string; link: string }[];
}

interface SubItem {
	text: string;
	link: string;
}

const navbar = await sanityClient.fetch(`*[_type == "navbar"][0]`);

const { buttonLinkText, buttonLink, buttonTitle, menuItems } = navbar;
---

<header class="fixed z-[999] w-screen border-b border-verylight bg-white">
	<nav
		class="mx-auto flex w-full max-w-7xl flex-wrap items-center justify-between bg-white px-4 py-2 text-gray-700 lg:px-4 lg:py-0"
	>
		<div class="z-[50]">
			<a href="/" aria-label="Home Page" class="flex items-center gap-2">
				<Icon name="logo" class="h-12 w-auto" />
			</a>
		</div>
		<div class="lg:hidden">
			<div
				role="button"
				id="hamburgerToggle"
				aria-label="Toggle Hamburger Menu"
				class="group relative grid h-16 w-16 place-items-center"
			>
				<div
					class="h-[2px] w-[30px] rounded-full bg-black transition-all duration-150 group-aria-expanded:h-0 group-aria-expanded:bg-white before:absolute before:h-[2px] before:w-[30px] before:-translate-y-[10px] before:rounded-full before:bg-black before:transition-all before:duration-150 before:content-[''] group-aria-expanded:before:translate-y-0 group-aria-expanded:before:rotate-45 after:absolute after:h-[2px] after:w-[30px] after:translate-y-[10px] after:rounded-full after:bg-black after:transition-all after:duration-150 after:content-[''] group-aria-expanded:after:translate-y-0 group-aria-expanded:after:-rotate-45"
				>
				</div>
			</div>
		</div>
		</div>
		<div
			class="absolute left-0 top-16 z-50 hidden h-screen w-screen translate-x-full justify-between overflow-y-scroll bg-white shadow-[0_3px_10px_rgb(0,0,0,0.2)] transition-all duration-500 ease-in-out lg:static lg:flex lg:h-auto lg:w-auto lg:translate-x-0 lg:items-center lg:overflow-visible lg:shadow-none"
			id="menu"
		>
			<ul
				class="flex h-fit w-full max-w-lg flex-col items-center justify-evenly gap-2 px-4 lg:mx-auto lg:max-w-7xl lg:flex-row"
			>
				{
					menuItems.map((item: MenuItem) => (
						<li class="menu group relative w-full cursor-pointer py-4 lg:w-auto lg:py-2">
							<div
								class={`${item.values ? "justify-between" : "justify-start"} group flex w-full items-center space-x-2 px-2 lg:justify-between xl:px-4`}
							>
								{!item.values ? (
									<a
										href={item.link}
										class="item my-2 py-2 font-medium text-sky-950 transition duration-300 ease-in-out hover:text-primary group-hover:text-primary"
									>
										{item.title}
									</a>
								) : (
									<p class="item my-2 py-2 font-medium text-sky-950 transition duration-300 ease-in-out hover:text-primary group-hover:text-primary">
										{item.title}
									</p>
								)}
								{item.values && (
									<span>
										<Icon
											id="chevronDown"
											name="chevronDown"
											size={16}
											class="transition-transform duration-300 ease-in-out lg:group-hover:rotate-180"
										/>
									</span>
								)}
							</div>
							<div>
								{item.values && (
									<div class="dropdown -left-32 top-[48px] z-50 h-auto max-h-0 max-w-6xl overflow-scroll transition-all duration-500 ease-in-out lg:absolute lg:hidden lg:max-h-fit lg:w-[824px] lg:overflow-visible lg:p-6 lg:group-focus-within:grid lg:group-hover:grid">
										<ul class="grid grid-cols-2 bg-white bg-right-top bg-no-repeat text-gray-800 shadow-[0px_0px_0px_1px_rgba(0,0,0,0.06),0px_1px_1px_-0.5px_rgba(0,0,0,0.06),0px_3px_3px_-1.5px_rgba(0,0,0,0.06),_0px_6px_6px_-3px_rgba(0,0,0,0.06),0px_12px_12px_-6px_rgba(0,0,0,0.06),0px_24px_24px_-12px_rgba(0,0,0,0.06)] lg:w-[824px] lg:grid-cols-3 lg:bg-[url('/nav-bg.webp')] lg:p-4 lg:group-focus-within:grid lg:group-hover:grid">
											<li class="col-span-2 my-0.5 px-2 lg:col-span-1">
												<a
													href={buttonLink}
													class="flex h-full flex-col justify-between rounded-lg bg-[#FAFAFE] px-4 py-3 transition-colors duration-300 ease-in-out hover:bg-verylight"
												>
													<p class="font-medium text-gray-900 sm:text-xl">{buttonTitle}</p>
													<p class="text-xs text-primary group-hover:opacity-70 lg:text-sm">
														{buttonLinkText}
													</p>
												</a>
											</li>
											<li class="lg:grid lg:grid-rows-4 lg:px-6">
												{item.values.slice(0, 4).map((subItem: { text: string; link: string }) => (
													<a
														href={subItem.link}
														class="block w-full border-b border-white px-2 py-4 text-start text-base font-normal text-gray-500 hover:bg-primary hover:text-white lg:py-1 lg:text-sm"
													>
														{subItem.text}
													</a>
												))}
											</li>
											<div class="lg:grid lg:grid-rows-4 lg:px-6">
												{item.values.slice(4, 8).map((subItem: { text: string; link: string }) => (
													<a
														href={subItem.link}
														class="block whitespace-nowrap border-b border-white px-2 py-4 text-start text-base font-normal text-gray-500 hover:bg-primary hover:text-white lg:py-1 lg:text-sm"
													>
														{subItem.text}
													</a>
												))}
											</div>
										</ul>
									</div>
								)}
							</div>
						</li>
					))
				}
			</ul>
		</div>
		<div class="hidden items-center gap-2 lg:flex lg:gap-4">
			<a
				href="/sign-in"
				class="item my-2 py-2 font-medium text-sky-950 transition duration-300 ease-in-out hover:text-primary group-hover:text-primary"
			>
				Log in
			</a>
			<Button buttonText="Get Started" link="/sign-up" type="filled" />
		</div>
	</nav>
</header>

<script>
	if (window.innerWidth <= 640) {
		document.querySelectorAll(".group.menu").forEach((dropdown) => {
			const arrow = dropdown.querySelector<HTMLElement>("#chevronDown");
			dropdown.addEventListener("click", () => {
				const currentDropdown = dropdown.querySelector(".dropdown");
				const allDropdowns = document.querySelectorAll(".dropdown");

				allDropdowns.forEach((dropdown) => {
					if (dropdown !== currentDropdown) {
						dropdown.classList.remove("max-h-[450px]");
						arrow!.classList.remove("rotate-180");
					}
				});
				if (currentDropdown && currentDropdown.classList) {
					currentDropdown.classList.toggle("max-h-[450px]");
				}
				arrow!.classList.toggle("rotate-180");
			});
		});
	}

	document.getElementById("hamburgerToggle")!.addEventListener("click", () => {
		const hamburgerToggle = document.getElementById("hamburgerToggle")!;
		const menu = document.getElementById("menu")!;
		const isExpanded = hamburgerToggle.getAttribute("aria-expanded") === "true";
		if (isExpanded) {
			menu.classList.add("translate-x-full");
			setTimeout(() => {
				menu.classList.add("hidden");
			}, 200);
		} else {
			menu.classList.remove("hidden");
			setTimeout(() => {
				menu.classList.remove("translate-x-full");
			}, 200);
		}
		hamburgerToggle.setAttribute("aria-expanded", String(!isExpanded));
	});
</script>
