---
import { Picture, getImage } from "astro:assets";
import myBackground from "../assets/bg2.webp";
import hero from "../assets/hero.webp";
import Button from "./reusable/Button.astro";

// Define the interface for the button props
interface ButtonProps {
  link: string;
  buttonText: string;
  type: "filled" | "outline";
  arrow?: boolean;
}

// Define the interface for the component props
interface CustomSectionProps {
  first: boolean;
  largeImage: boolean;
  background: boolean;
  title: string;
  description: string;
  button1?: ButtonProps;
  button2?: ButtonProps;
  heroSrc?: ImageMetadata;
  heroAlt?: string;
}

const {
  largeImage = false,
  first = false,
  background = true,
  title,
  description,
  button1 = {
    link: "#",
    buttonText: "Request a demo",
    type: "filled",
    arrow: true,
  },
  button2 = { link: "#", buttonText: "Contact Sales", type: "outline" },
  heroSrc = hero,
  heroAlt = "A prototype of the app.",
} = Astro.props as CustomSectionProps;

const optimizedBackground = await getImage({
  src: myBackground,
  format: "webp",
});
---

<section
  style={`background-image: ${background ? `url(${optimizedBackground.src})` : "none"};`}
  class={`py-8 ${first ? "lg:pt-44 pb-20" : "sm:py-40"}  ${background ? "bg-cover bg-no-repeat" : ""}`}
>
  <div
    class="max-w-6xl flex flex-col lg:flex-row gap-8 lg:gap-20 items-center justify-center mx-auto px-4"
  >
    <div class={`${largeImage && "lg:w-2/5"} max-w-xl`}>
      <div class="text-center lg:text-start">
        <h1
          class={`font-heading mt-3 ${first ? "text-3xl sm:text-6xl" : "text-3xl sm:text-4xl"} font-bold leading-10 sm:leading-[4rem] tracking-tight text-black`}
        >
          {title}
        </h1>
        <p class="mt-3 text-lg leading-relaxed text-slate-500">
          {description}
        </p>
      </div>

      <div class="mt-6 flex items-center justify-center lg:justify-start gap-4">
        <Button
          link={button1.link}
          buttonText={button1.buttonText}
          type={button1.type}
          arrow={button1.arrow}
        />
        <Button
          link={button2.link}
          buttonText={button2.buttonText}
          type={button2.type}
        />
      </div>
    </div>
    <div class={`${largeImage && "lg:h-[70vh] lg:w-3/5 w-full h-auto"} `}>
      <Picture
        src={heroSrc}
        formats={["avif", "webp"]}
        alt={heroAlt}
        sizes="(max-width: 640px) 50vw, 100vw"
        widths={[400, 800, heroSrc.width]}
        class="h-full w-full object-cover object-left"
      />
    </div>
  </div>
</section>
