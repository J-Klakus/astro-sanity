---
import { Picture, getImage } from "astro:assets";
import myBackground from "../assets/bg2.webp";
import hero from "../assets/hero.webp";
import Button from "./reusable/Button.astro";

const optimizedBackground = await getImage({
  src: myBackground,
  format: "webp",
});
---

<section
  style={`background-image: url(${optimizedBackground.src});`}
  class="py-8 sm:py-40 bg-cover bg-no-repeat"
>
  <div
    class="max-w-6xl flex flex-col md:flex-row gap-8 lg:gap-20 items-center justify-center mx-auto px-4"
  >
    <div class="max-w-xl">
      <div class="text-center md:text-start">
        <h1
          class="font-heading mt-3 text-4xl font-bold leading-[4rem] tracking-tight text-black"
        >
          Ready to transform your recruitment? Try for free!
        </h1>
        <p class="mt-3 text-lg leading-relaxed text-slate-500">
          Start your free trial of our all-in-one recruitment solution and see
          faster results. Our team is here to assist you at every step as you
          explore our innovative platform.
        </p>
      </div>

      <div class="mt-6 flex items-center justify-center md:justify-start gap-4">
        <Button
          link="#"
          buttonText="Request a demo"
          type="filled"
          arrow={true}
        />
        <Button link="#" buttonText="Contact Sales" type="outline" />
      </div>
    </div>
    <div>
      <Picture
        src={hero}
        formats={["avif", "webp"]}
        alt="A prototype of the app."
        sizes="(min width 640px) 50vw, 100vw"
        widths={[400, 800, hero.width]}
        class="h-full w-auto"
      />
    </div>
  </div>
</section>
