---
import { Icon } from "astro-icon/components";
import Button from "./reusable/Button.astro";
---

<section
	class="bg-[url('/bg-center-mobile.webp')] bg-cover bg-no-repeat sm:bg-[url('/bg-center.webp')]"
>
	<div class="mx-auto max-w-7xl">
		<div
			class="mx-auto flex flex-col-reverse items-center justify-center gap-8 px-4 lg:flex-row lg:gap-16"
		>
			<div class="my-8 bg-white p-2 md:px-12 md:py-8 lg:w-1/2">
				<form>
					<p class="mb-6 font-heading font-medium text-primary sm:text-2xl">Lets Talk!</p>
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0">
						<!-- Left Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="full-name"
									>Name</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="full-name"
									type="text"
									placeholder="Full Name"
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="phone">Phone</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="phone"
									type="text"
									placeholder="(000) 000 000 000"
								/>
							</div>
						</div>
						<!-- Right Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="email">Email</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="email"
									type="email"
									placeholder="Email address"
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="company"
									>Company</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="company"
									type="text"
									placeholder="Company name"
								/>
							</div>
						</div>
						<div class="col-span-2 mb-4">
							<label class="mb-2 block text-sm font-medium text-primary" for="message"
								>Message</label
							>
							<textarea
								rows={6}
								class="focus:shadow-outline w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
								id="website"></textarea>
						</div>
					</div>
					<div class="mt-6 flex justify-end">
						<Button buttonText="Submit" link="/" type="filled" />
					</div>
				</form>
			</div>
			<div class="lg:w-1/2">
				<h2 class="mb-6 font-heading font-medium text-gray-900 sm:text-3xl">
					Get a Custom Pricing Quote
				</h2>
				<p class="mb-6 font-heading font-normal text-gray-500">
					Connect with our account managers to tailor a pricing plan that fits your recruitment
					goals and budget.
				</p>
			</div>
		</div>
	</div>
</section>
