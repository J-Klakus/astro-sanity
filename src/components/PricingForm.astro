---
import { Icon } from "astro-icon/components";
import FormButton from "./reusable/FormButton.astro";
const { title, text, text2, formTitle, list } = Astro.props;
---

<section
	class="bg-[url('/bg-center-mobile.webp')] bg-cover bg-no-repeat sm:bg-[url('/bg-center.webp')]"
>
	<div class="mx-auto max-w-7xl">
		<div
			class="mx-auto flex flex-col-reverse items-center justify-center px-4 md:gap-8 lg:flex-row lg:gap-16"
		>
			<div class="bg-white p-2 md:my-8 md:px-12 md:py-8 lg:w-1/2">
				<form action="https://submit-form.com/MTMFENfyt">
					<input type="hidden" name="form-type" value="pricing form" />
					<input type="hidden" name="_redirect" value={Astro.site + "success"} />
					<input type="hidden" name="_error" value={Astro.site + "error"} />
					<input type="hidden" name="_append" value="false" />
					{
						formTitle && (
							<p class="mb-6 font-heading font-medium text-primary sm:text-2xl">{formTitle}</p>
						)
					}
					<div class="grid grid-cols-1 gap-6 md:grid-cols-2 md:gap-y-0">
						<!-- Left Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="full-name"
									>Name</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="full-name"
									name="full-name"
									type="text"
									placeholder="Full Name"
									required
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="phone">Phone</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="phone"
									name="phone"
									type="text"
									placeholder="(000) 000 000 000"
								/>
							</div>
						</div>
						<!-- Right Side -->
						<div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="email">Email</label>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="email"
									name="email"
									type="email"
									placeholder="Email address"
									required
								/>
							</div>
							<div class="mb-4">
								<label class="mb-2 block text-sm font-medium text-primary" for="company"
									>Company</label
								>
								<input
									class="focus:shadow-outline h-10 w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
									id="company"
									name="company"
									type="text"
									placeholder="Company name"
								/>
							</div>
						</div>
						<div class="col-span-2 mb-4">
							<label class="mb-2 block text-sm font-medium text-primary" for="message"
								>Message</label
							>
							<textarea
								rows={6}
								class="focus:shadow-outline w-full appearance-none rounded-lg border border-gray-400 px-3 py-2 leading-tight text-primary focus:outline-none"
								id="message"
								name="message"
								required></textarea>
						</div>
					</div>
					<div class="mt-6 flex justify-end">
						<FormButton buttonText="Submit" link="/" type="filled" />
					</div>
				</form>
			</div>
			<div class="mt-6 md:mt-0 lg:w-1/2">
				<h2
					class="mb-6 bg-[linear-gradient(112deg,#4B3AB3_40%,#9FFFF3_100%)] bg-clip-text font-heading text-xl font-medium text-transparent sm:text-3xl"
				>
					{title}
				</h2>
				{text && <p class="mb-6 font-heading font-normal text-gray-500">{text}</p>}
				{text2 && <p class="mb-6 font-heading font-normal text-gray-500">{text2}</p>}
				{
					list && (
						<ul class="space-y-4 font-heading font-medium text-black sm:text-xl">
							{list.map((item: { title: string; text: string }) => (
								<li>
									<Icon name="tick" class="mb-0.5 mr-2 inline" size={20} /> {item.title}{" "}
									{item.text &&
																		<p class="mb-6 ml-8 font-heading text-base font-normal text-gray-900">
										{item.text}
									</p>
									}
								</li>
							))}
						</ul>
					)
				}
			</div>
		</div>
	</div>
</section>
