---
import Button from "./reusable/Button.astro";

const { categories, title, subtitle, price } = Astro.props;
---

<section
	class="bg-[url('/bg-bottom-mobile.webp')] bg-cover bg-[center_bottom_-4rem] sm:bg-[url('/bg-bottom.webp')] lg:py-20"
>
	<div class="mx-auto max-w-7xl bg-white/80">
		<div class="grid grid-cols-1 gap-6 p-8 md:grid-cols-2 lg:grid-cols-4">
			<div class="p-4 lg:col-span-3">
				<h2
					class="inline-block bg-text-gradient bg-clip-text pb-1 font-heading text-2xl font-medium text-transparent md:text-4xl/normal"
				>
					{title}
				</h2>
				<p class="mt-2 leading-relaxed text-slate-500 sm:text-lg">
					{subtitle}
					<span class="font-semibold text-primary">{price} </span>
				</p>
			</div>
			<div class="lg:col-span-1">
				<div class="mt-6 flex items-center justify-center gap-4 lg:justify-start">
					<Button link="/sign-up" buttonText="Try Now" type="filled" />
					<Button link="/contact" buttonText="Contact Sales" type="outline" />
				</div>
			</div>
		</div>
		<div class="grid grid-cols-1 gap-6 p-4 md:grid-cols-2 lg:grid-cols-4">
			{
				categories.map((item: { category: string; features: string[] }) => (
					<div class="bg-verylight p-4 md:bg-transparent">
						<p class="mb-3 font-heading font-semibold sm:text-xl">{item.category}</p>
						<ul class="space-y-3">
							{item.features.map((subitem: string) => (
								<li class="font-medium text-gray-900 before:mr-3 before:font-black before:text-transparent before:content-['✓'] before:[text-shadow:_0_1px_0_#0E9F6E]">
									{subitem}
								</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</div>
</section>
