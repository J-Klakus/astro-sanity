---
import { sanityClient } from "sanity:client";
import BlogCard from "./reusable/BlogCard.astro";
import { type ImageRef } from "../utils/imageHelper";

const { slug } = Astro.props;

type Blog = {
	title: string;
	slug: { current: string };
	categories: string[];
	publishedAt: string;
	mainImage: ImageRef;
	verticalImage: ImageRef;
};

const blogs = await sanityClient.fetch(
	`*[_type == "blogs" && defined(author)] | order(publishedAt desc) {
        title,
        slug,
        "categories": categories[]->title,
        publishedAt,
        mainImage,
        verticalImage,
        "author": author->{
            name,
            image
        }
    }`,
);
---

<div class="flex flex-col gap-4 md:px-4 lg:w-1/4">
	<h2 class="text-xl font-medium text-gray-600">Related Articles</h2>
	{
		blogs
			.filter((blog: Blog) => blog.slug.current !== slug)
			.map((blog: Blog, index: number) => <BlogCard index={0} blog={blog} isAside={true} />)
	}
</div>
