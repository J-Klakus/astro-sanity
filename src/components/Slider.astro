---
import { Icon } from "astro-icon/components";
import { Image, Picture, getImage } from "astro:assets";
import imageHelper from "../utils/imageHelper";
import type { ImageRef } from "../utils/imageHelper";
import cardBackground from "../assets/card-bg.webp";
import hero from "../assets/hero.webp";

const optimizedCardBackground = await getImage({
	src: cardBackground,
	format: "webp",
});
let { items } = Astro.props;

items = [
	{
		id: "placeholder",
		description: "",
	},
	...items,
	{
		id: "placeholder",
		description: "",
	},
];
---

<section
	class="bg- flex flex-col items-center justify-center gap-8 bg-[url('/bg-slider-mobile.webp')] bg-[center_top_2rem] bg-no-repeat px-6 pb-8 sm:bg-[url('/bg-slider.webp')] md:pb-44 md:pt-0"
>
	<div class="mx-auto max-w-7xl">
		<div class="mx-auto flex max-w-2xl flex-col text-center lg:mb-4">
			<p
				class="mx-auto my-1 w-fit rounded-lg bg-verylight px-2 py-1 font-medium uppercase tracking-wide text-highlight"
			>
				Features
			</p>
			<h2
				class="mt-3 font-heading text-3xl font-medium leading-10 tracking-tight text-black sm:text-4xl sm:leading-[4rem]"
			>
				Explore features designed to simplify your work
			</h2>
		</div>
	</div>

	<div
		class="relative mx-auto flex w-[90vw] max-w-[1400px] items-center justify-between pb-6 xl:w-[90vw]"
	>
		<button class="prev-button z-50">
			<Icon name="prev" class="h-auto w-12 rounded-full border border-[#E3E0F3] p-4 lg:w-16" />
		</button>
		<div class="absolute left-0 top-0 h-full w-full">
			<button
				class="prev-button absolute z-20 h-full w-[20%] bg-gradient-to-r from-white from-[40%] to-transparent"
			>
			</button>
			<button
				class="next-button absolute right-0 top-0 z-20 h-full w-[20%] bg-gradient-to-l from-white from-[40%] to-transparent"
			>
			</button>
		</div>
		<ul class="scroll flex flex-grow snap-x snap-mandatory overflow-x-auto">
			{
				items.map(async (item: { id: string; description: string; image: ImageRef }) =>
					item.id === "placeholder" ? (
						<li class="group z-10 w-1/2 flex-shrink-0 flex-grow cursor-pointer snap-start sm:w-1/3 lg:w-[12.5%]">
							<div class="flex flex-col items-center justify-center rounded-lg py-2.5">
								<div class="h- rounded-full border-[1px] border-verylight p-4 group-hover:bg-[#F3F3FB]" />
							</div>
						</li>
					) : (
						<li
							id={`${item.id}Button`}
							data-image={
								item.image
									? await (
											await getImage({
												src: imageHelper(item.image).url(),
												format: "webp",
												inferSize: true,
											})
										).src
									: hero.src
							}
							class="group z-10 w-1/2 flex-shrink-0 flex-grow cursor-pointer snap-start sm:w-1/3 lg:w-[12.5%]"
						>
							<div class="flex flex-col items-center justify-center space-y-2 rounded-lg py-2.5">
								<div class="rounded-full border-[1px] border-verylight p-4 group-hover:bg-[#F3F3FB]">
									<Icon name={item.id} size={24} class="m-1" />
								</div>
								<p class="text-xs font-medium capitalize group-hover:text-primary sm:text-base">
									{item.id}
								</p>
							</div>
						</li>
					),
				)
			}
		</ul>
		<button class="next-button z-50">
			<Icon
				name="next"
				class="h-auto w-12 rounded-full border border-[#E3E0F3] p-4 lg:w-16"
			/></button
		>
	</div>
	<div class="relative flex max-w-3xl flex-col-reverse px-4 sm:py-10 lg:block lg:px-0">
		<Image
			id="specialImage"
			src={hero}
			alt="A prototype of the app."
			loading="eager"
			class="h-full w-auto rounded-xl pt-2 shadow-[0px_-20px_100px_50px_rgba(229,248,249,0.5)] transition-opacity duration-300 ease-in-out lg:pt-0"
		/>
		<div
			style={`background-image: url(${optimizedCardBackground.src})`}
			class="group rounded-xl border-2 border-[#E3E0F3] bg-cover bg-no-repeat backdrop-blur-sm lg:absolute lg:-bottom-[20%] lg:-right-[10%] lg:h-96 lg:w-[272px]"
		>
			{
				items
					.filter(
						(item: { id: string; description: string; image: ImageRef }) =>
							item.id !== "placeholder",
					)
					.map((item: { id: string; description: string; image: ImageRef }, index: number) => (
						<div
							id={item.id}
							class={`flex h-full flex-col justify-start p-4 pt-4 ${index > 0 && "hidden"}`}
						>
							<Icon name={item.id} size={36} class="z-10 mb-4 text-primary lg:mb-12" />
							<div>
								<h2 class="font-medium capitalize text-primary sm:text-xl">{item.id}</h2>
								<p class="mt-3 text-base leading-relaxed text-gray-900">{item.description}</p>
							</div>
						</div>
					))
			}
		</div>
	</div>
</section>

<style>
	ul::-webkit-scrollbar {
		display: none;
	}
</style>

<script>
	const items = [
		"opportunities",
		"companies",
		"candidates",
		"reports",
		"shortlist",
		"jobs",
		"settings",
		"leads",
		"contacts",
		"notes",
		"task",
		"meetings",
	];

	items.forEach((item) => {
		const button = document.getElementById(`${item}Button`);
		const image = document.getElementById("specialImage") as HTMLImageElement;
		if (button) {
			button.addEventListener("click", () => {
				// Hide all elements and remove button background class
				items.forEach((i) => {
					const element = document.getElementById(i);
					const btn = document.getElementById(`${i}Button`);
					if (element) {
						element.classList.add("hidden");
					}
					if (btn) {
						(btn.firstElementChild?.firstElementChild as HTMLElement)?.classList.remove(
							"bg-verylight",
						);
					}
				});
				const element = document.getElementById(item);
				if (element) {
					image.style.opacity = "0";
					setTimeout(() => {
						// Change the image src
						image.src = button.getAttribute("data-image") as string;
						// Fade in the new image
						image.style.opacity = "1";
					}, 300); // Ensure this delay matches the transition duration in CSS
					element.classList.remove("hidden");
				}
				(button.firstElementChild?.firstElementChild as HTMLElement)?.classList.add("bg-verylight");
			});
		}
	});
	const totalElements = 14;
	let elementsPerPage = 2;
	if (window.innerWidth > 1024) {
		elementsPerPage = 8;
	} else if (window.innerWidth > 640) elementsPerPage = 3;

	const easingOutQuint = (x: number, t: number, b: number, c: number, d: number) =>
		c * ((t = t / d - 1) * t * t * t * t + 1) + b;

	function smoothScrollPolyfill(
		node: HTMLElement,
		key: "scrollTop" | "scrollLeft",
		target: number,
	): () => void {
		const startTime = Date.now();
		const offset = node[key];
		const gap = target - offset;
		const duration = 1000;
		let interrupt = false;

		const step = () => {
			const elapsed = Date.now() - startTime;
			const percentage = elapsed / duration;

			if (interrupt) {
				return;
			}

			if (percentage > 1) {
				cleanup();
				return;
			}

			node[key] = easingOutQuint(0, elapsed, offset, gap, duration);
			requestAnimationFrame(step);
		};

		const cancel = () => {
			interrupt = true;
			cleanup();
		};

		const cleanup = () => {
			node.removeEventListener("wheel", cancel);
			node.removeEventListener("touchstart", cancel);
		};

		node.addEventListener("wheel", cancel, { passive: true });
		node.addEventListener("touchstart", cancel, { passive: true });

		step();

		return cancel;
	}

	function testSupportsSmoothScroll(): boolean {
		let supports = false;
		try {
			const div = document.createElement("div");
			div.scrollTo({
				top: 0,
				get behavior(): ScrollBehavior | undefined {
					supports = true;
					return "smooth";
				},
			});
		} catch (err) {}
		return supports;
	}

	const hasNativeSmoothScroll = testSupportsSmoothScroll();

	function smoothScroll(
		node: HTMLElement,
		topOrLeft: number,
		horizontal: boolean,
	): void | (() => void) {
		if (hasNativeSmoothScroll) {
			return node.scrollTo({
				[horizontal ? "left" : "top"]: topOrLeft,
				behavior: "smooth",
			});
		} else {
			return smoothScrollPolyfill(node, horizontal ? "scrollLeft" : "scrollTop", topOrLeft);
		}
	}

	function debounce(func: () => void, ms: number): () => void {
		let timeout: any = null;
		return () => {
			if (timeout) {
				clearTimeout(timeout);
			}
			timeout = setTimeout(() => {
				timeout = null;
				func();
			}, ms);
		};
	}

	const prevButton = document.querySelectorAll<HTMLButtonElement>(".prev-button");
	const nextButton = document.querySelectorAll<HTMLButtonElement>(".next-button");
	const scroller = document.querySelector(".scroll") as HTMLElement;

	if (prevButton && nextButton && scroller) {
		function setAriaLabels() {
			if (prevButton && nextButton) {
				prevButton.forEach((button) =>
					button.setAttribute("aria-label", "Scroll to previous item"),
				);
				nextButton.forEach((button) => button.setAttribute("aria-label", "Scroll to next item"));
			}
		}

		function setAriaPressed(index: number) {
			if (prevButton && nextButton) {
				prevButton.forEach((button) =>
					button.setAttribute("aria-pressed", (index === 0).toString()),
				);
				nextButton.forEach((button) =>
					button.setAttribute("aria-pressed", (index === elementsPerPage).toString()),
				);
			}
		}

		function getIndex(): number {
			const totalWidth = scroller.scrollWidth;
			const elementWidth = totalWidth / totalElements;
			const currentIndex = Math.round(scroller.scrollLeft / elementWidth);
			return currentIndex;
		}

		function handleScroll(direction: "prev" | "next") {
			const currentIndex = getIndex();
			let targetIndex = currentIndex;

			const maxTargetIndex = totalElements - 1;

			if (direction === "prev" && currentIndex > 0) {
				targetIndex -= 1;
			} else if (direction === "next" && currentIndex < maxTargetIndex) {
				targetIndex += 1;
			}

			setAriaPressed(targetIndex);

			const elementWidth = scroller.scrollWidth / totalElements;
			const scrollLeft = elementWidth * targetIndex;
			smoothScroll(scroller, scrollLeft, true);
		}

		prevButton.forEach((button) => {
			button.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				handleScroll("prev");
			});
		});

		nextButton.forEach((button) => {
			button.addEventListener("click", (e) => {
				e.preventDefault();
				e.stopPropagation();
				handleScroll("next");
			});
		});
		scroller.addEventListener(
			"scroll",
			debounce(() => {
				setAriaPressed(getIndex());
			}, 200),
		);

		setAriaLabels();

		window.addEventListener("load", () => {
			const elementWidth = scroller.scrollWidth / totalElements;
			const initialScrollLeft = elementWidth * 1; // Index 1 for the second element
			smoothScroll(scroller, initialScrollLeft, true);

			const elementsWithButtonId = document.querySelectorAll('[id*="Button"]');

			const imageSources: string[] = Array.from(elementsWithButtonId)
				.map((button) => button.getAttribute("data-image"))
				.filter((src): src is string => src !== null);
			const preload = async () => {
				await Promise.all(
					imageSources.map(
						(a) =>
							new Promise((res) => {
								const preloadImage = new Image();
								preloadImage.onload = res;
								preloadImage.src = a;
							}),
					),
				);
			};
			preload();
		});
	}
</script>
