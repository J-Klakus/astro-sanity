---
import { Icon } from "astro-icon/components";
import { Picture, getImage } from "astro:assets";
import myBackground from "../assets/bg.webp";
import cardBackground from "../assets/card-bg.webp";
import hero from "../assets/hero.webp";

const optimizedBackground = await getImage({
  src: myBackground,
  format: "webp",
});

const optimizedCardBackground = await getImage({
  src: cardBackground,
  format: "webp",
});

const items = [
  {
    id: "placeholder",
    description: "",
  },
  {
    id: "opportunities",
    description:
      "Effectively manage recruitment opportunities from start to finish. Work on opportunities before they become active jobs and convert them seamlessly when ready, staying ahead in your recruitment efforts.",
  },
  {
    id: "companies",
    description:
      "Get a comprehensive view of all your clients and their job openings in one place. Quickly access associated contacts and have all client communications automatically linked within your ATS for seamless management.",
  },
  {
    id: "candidates",
    description:
      "Effortlessly manage your candidates with a user-friendly interface that displays all essential information—assigned jobs, tasks, notes, and CVs—on one page. Customize the data layout to highlight what matters most to your company.",
  },
  {
    id: "reports",
    description:
      "Gain valuable insights into your recruitment process. Identify team strengths and weaknesses, track client revenue, time to hire, and more.",
  },
  {
    id: "shortlist",
    description:
      "Save and quickly access your top candidates. Share shortlists within your team or keep them private to ensure efficient collaboration and candidate management.",
  },
  {
    id: "jobs",
    description:
      "Streamline your hiring process with customizable Kanban boards for each job, visualizing candidate stages at a glance. Our AI suggests top candidates from your database, saving you time.",
  },
  {
    id: "settings",
    description:
      "Customize your UI and workflow to suit your agency's unique needs. Adjust settings, manage user permissions, and integrate seamlessly with your existing tools and systems for maximum flexibility.",
  },
  {
    id: "leads",
    description:
      "Capture and track potential clients effectively. Keep all calls, tasks, meetings, and emails in one place, and convert leads into contacts and companies with ease, ensuring smooth business development.",
  },
  {
    id: "contacts",
    description:
      "Find the right person fast and keep all emails associated with each contact easily accessible. Centralize and streamline communication with candidates, clients, and partners.",
  },
  {
    id: "notes",
    description:
      "Maintain comprehensive records by adding notes to candidate profiles, job listings, and client interactions. Document important details and insights directly within our ATS, ensuring you have all the information you need at your fingertips.",
  },
  {
    id: "task",
    description:
      "Keep your recruitment process on track by managing tasks efficiently. Assign tasks to team members, set deadlines, and monitor progress within our ATS. Ensure that every step of your recruitment workflow is completed on time.",
  },
  {
    id: "meetings",
    description:
      "Efficiently schedule and manage recruitment meetings within our ATS. Keep track of interviews, client calls, and team discussions with automated reminders and integrated calendar syncing. ",
  },
  {
    id: "placeholder",
    description: "",
  },
];
---

<section
  class="px-6 pb-8 md:pb-44 bg- bg-[center_top_2rem] bg-[url('/bg-slider-mobile.webp')] sm:bg-[url('/bg-slider.webp')] flex flex-col gap-8 items-center justify-center bg-no-repeat"
>
  <div class="max-w-7xl mx-auto">
    <div class="text-center max-w-2xl mx-auto flex flex-col lg:mb-4">
      <p
        class="text-highlight bg-verylight rounded-lg w-fit px-2 py-1 uppercase font-medium tracking-wide my-1 mx-auto"
      >
        Features
      </p>
      <h2
        class="font-heading mt-3 text-3xl sm:text-4xl font-medium leading-10 sm:leading-[4rem] tracking-tight text-black"
      >
        Explore features designed to simplify your work
      </h2>
    </div>
  </div>

  <div
    class="w-[90vw] xl:w-[90vw] max-w-[1400px] flex justify-between items-center mx-auto pb-6 relative"
  >
    <button class="prev-button z-50">
      <Icon
        name="prev"
        class="border border-[#E3E0F3] rounded-full p-4 w-12 lg:w-16 h-auto"
      />
    </button>
    <div
      class="top-0 left-0 before:z-20 after:z-20 absolute w-full h-full before:h-full before:w-[20%] before:absolute before:content-[''] before:bg-gradient-to-r before:from-white before:from-[40%] before:to-transparent after:top-0 after:h-full after:w-[20%] after:right-0 after:absolute after:content-[''] after:bg-gradient-to-l after:from-white after:from-[40%] after:to-transparent"
    >
    </div>
    <ul class="scroll flex flex-grow snap-x snap-mandatory overflow-x-auto">
      {
        items.map((item) =>
          item.id === "placeholder" ? (
            <li class="snap-start w-1/2 sm:w-1/3 lg:w-[12.5%] flex-grow flex-shrink-0 cursor-pointer group z-10">
              <div class="flex flex-col justify-center items-center rounded-lg py-2.5">
                <div class="group-hover:bg-[#F3F3FB] border-verylight border-[1px] rounded-full p-4 h-" />
              </div>
            </li>
          ) : (
            <li
              id={`${item.id}Button`}
              class="snap-start w-1/2 sm:w-1/3 lg:w-[12.5%] flex-grow flex-shrink-0 cursor-pointer group z-10"
            >
              <div class="space-y-2 flex flex-col justify-center items-center rounded-lg py-2.5">
                <div class="group-hover:bg-[#F3F3FB] border-verylight border-[1px] rounded-full p-4">
                  <Icon name={item.id} size={24} class="m-1" />
                </div>
                <p class="text-xs sm:text-base font-medium capitalize group-hover:text-primary">
                  {item.id}
                </p>
              </div>
            </li>
          )
        )
      }
    </ul>
    <button class="next-button z-50">
      <Icon
        name="next"
        class="border border-[#E3E0F3] rounded-full p-4 w-12 lg:w-16 h-auto"
      /></button
    >
  </div>
  <div
    class="max-w-3xl flex flex-col-reverse lg:block relative sm:py-10 px-4 lg:px-0"
  >
    <Picture
      fallbackFormat="jpg"
      src={hero}
      formats={["avif", "webp"]}
      alt="A prototype of the app."
      sizes="(max-width: 768px) 100vw, 768px"
      widths={[400, 800, 1200, hero.width]}
      loading="eager"
      class="h-full w-auto shadow-[0px_-20px_100px_50px_rgba(229,248,249,0.5)] rounded-xl pt-2 lg:pt-0"
    />
    <div
      style={`background-image: url(${optimizedCardBackground.src})`}
      class="bg-cover bg-no-repeat lg:absolute lg:w-3/6 lg:h-[70%] lg:-bottom-[20%] lg:-right-[20%] border-2 border-[#E3E0F3] group rounded-xl"
    >
      {
        items
          .filter((item) => item.id !== "placeholder")
          .map((item, index) => (
            <div
              id={item.id}
              class={`h-full flex flex-col justify-start pt-4 p-4 ${index > 0 && "hidden"}`}
            >
              <Icon
                name={item.id}
                size={36}
                class="text-primary z-10 mb-4 lg:mb-12"
              />
              <div>
                <h2 class="text-xl font-medium text-primary capitalize">
                  {item.id}
                </h2>
                <p class="mt-3 text-base leading-relaxed text-gray-900">
                  {item.description}
                </p>
              </div>
            </div>
          ))
      }
    </div>
  </div>
</section>

<style>
  ul::-webkit-scrollbar {
    display: none;
  }
</style>

<script>
  const items = [
    "opportunities",
    "companies",
    "candidates",
    "reports",
    "shortlist",
    "jobs",
    "settings",
    "leads",
    "contacts",
    "notes",
    "task",
    "meetings",
  ];

  items.forEach((item) => {
    const button = document.getElementById(`${item}Button`);
    if (button) {
      button.addEventListener("click", () => {
        // Hide all elements and remove button background class
        items.forEach((i) => {
          const element = document.getElementById(i);
          const btn = document.getElementById(`${i}Button`);
          if (element) {
            element.classList.add("hidden");
          }
          if (btn) {
            (
              btn.firstElementChild?.firstElementChild as HTMLElement
            )?.classList.remove("bg-verylight");
          }
        });

        // Show the clicked element and add button background class
        const element = document.getElementById(item);
        if (element) {
          element.classList.remove("hidden");
        }
        (
          button.firstElementChild?.firstElementChild as HTMLElement
        )?.classList.add("bg-verylight");
      });
    }
  });
  const totalElements = 14;
  let elementsPerPage = 2;
  if (window.innerWidth > 1024) {
    elementsPerPage = 8;
  } else if (window.innerWidth > 640) elementsPerPage = 3;

  const easingOutQuint = (
    x: number,
    t: number,
    b: number,
    c: number,
    d: number
  ) => c * ((t = t / d - 1) * t * t * t * t + 1) + b;

  function smoothScrollPolyfill(
    node: HTMLElement,
    key: "scrollTop" | "scrollLeft",
    target: number
  ): () => void {
    const startTime = Date.now();
    const offset = node[key];
    const gap = target - offset;
    const duration = 1000;
    let interrupt = false;

    const step = () => {
      const elapsed = Date.now() - startTime;
      const percentage = elapsed / duration;

      if (interrupt) {
        return;
      }

      if (percentage > 1) {
        cleanup();
        return;
      }

      node[key] = easingOutQuint(0, elapsed, offset, gap, duration);
      requestAnimationFrame(step);
    };

    const cancel = () => {
      interrupt = true;
      cleanup();
    };

    const cleanup = () => {
      node.removeEventListener("wheel", cancel);
      node.removeEventListener("touchstart", cancel);
    };

    node.addEventListener("wheel", cancel, { passive: true });
    node.addEventListener("touchstart", cancel, { passive: true });

    step();

    return cancel;
  }

  function testSupportsSmoothScroll(): boolean {
    let supports = false;
    try {
      const div = document.createElement("div");
      div.scrollTo({
        top: 0,
        get behavior(): ScrollBehavior | undefined {
          supports = true;
          return "smooth";
        },
      });
    } catch (err) {}
    return supports;
  }

  const hasNativeSmoothScroll = testSupportsSmoothScroll();

  function smoothScroll(
    node: HTMLElement,
    topOrLeft: number,
    horizontal: boolean
  ): void | (() => void) {
    if (hasNativeSmoothScroll) {
      return node.scrollTo({
        [horizontal ? "left" : "top"]: topOrLeft,
        behavior: "smooth",
      });
    } else {
      return smoothScrollPolyfill(
        node,
        horizontal ? "scrollLeft" : "scrollTop",
        topOrLeft
      );
    }
  }

  function debounce(func: () => void, ms: number): () => void {
    let timeout: any = null;
    return () => {
      if (timeout) {
        clearTimeout(timeout);
      }
      timeout = setTimeout(() => {
        timeout = null;
        func();
      }, ms);
    };
  }

  const prevButton = document.querySelector(
    ".prev-button"
  ) as HTMLButtonElement;
  const nextButton = document.querySelector(
    ".next-button"
  ) as HTMLButtonElement;
  const scroller = document.querySelector(".scroll") as HTMLElement;

  function setAriaLabels() {
    if (prevButton && nextButton) {
      prevButton.setAttribute("aria-label", "Scroll to previous item");
      nextButton.setAttribute("aria-label", "Scroll to next item");
    }
  }

  function setAriaPressed(index: number) {
    if (prevButton && nextButton) {
      prevButton.setAttribute("aria-pressed", (index === 0).toString());
      nextButton.setAttribute(
        "aria-pressed",
        (index === elementsPerPage).toString()
      );
    }
  }

  function getIndex(): number {
    const totalWidth = scroller.scrollWidth;
    const elementWidth = totalWidth / totalElements;
    const currentIndex = Math.round(scroller.scrollLeft / elementWidth);
    return currentIndex;
  }

  function handleScroll(direction: "prev" | "next") {
    const currentIndex = getIndex();
    let targetIndex = currentIndex;

    const maxTargetIndex = totalElements - 1;

    if (direction === "prev" && currentIndex > 0) {
      targetIndex -= 1;
    } else if (direction === "next" && currentIndex < maxTargetIndex) {
      targetIndex += 1;
    }

    setAriaPressed(targetIndex);

    const elementWidth = scroller.scrollWidth / totalElements;
    const scrollLeft = elementWidth * targetIndex;
    smoothScroll(scroller, scrollLeft, true);
  }

  if (prevButton || nextButton || scroller) {
    prevButton.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      handleScroll("prev");
    });

    nextButton.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      handleScroll("next");
    });

    scroller.addEventListener(
      "scroll",
      debounce(() => {
        setAriaPressed(getIndex());
      }, 200)
    );

    setAriaLabels();

    window.addEventListener("load", () => {
      const elementWidth = scroller.scrollWidth / totalElements;
      const initialScrollLeft = elementWidth * 1; // Index 1 for the second element
      smoothScroll(scroller, initialScrollLeft, true);
    });
  }
</script>
