---
const { text, position, color } = Astro.props as {
  text: string;
  position: "top-left" | "top-right" | "bottom-left" | "bottom-right";
  color: "white" | "purple";
};

// Function to map position prop to CSS classes
const positionClasses =
  {
    "top-left": "top-2 left-1 top-3 sm:left-3",
    "top-right": "top-2 right-1 sm:top-3 sm:right-3",
    "bottom-left": "bottom-2 left-1 sm:bottom-3 left-3",
    "bottom-right": "bottom-2 right-1 sm:bottom-3 right-3",
  }[position] || "";

// Function to map color prop to CSS classes
const colorClasses =
  {
    white: "bg-white text-gray-800 hover:bg-gray-200",
    purple: "bg-primary text-white hover:bg-primary",
  }[color] || "bg-gray-100 text-primary hover:bg-gray-200";
---

<div
  class={`absolute ${positionClasses} ${colorClasses} px-3 sm:px-4 py-2 text-xs sm:text-sm font-medium rounded-full`}
>
  {text}
</div>
